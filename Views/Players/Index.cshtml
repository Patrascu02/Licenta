@model IEnumerable<Licenta.Models.Roles.Player>

@{
    ViewData["Title"] = "Lotul de Jucători";

    string GetAvatarColor(int id)
    {
        var colors = new[] {
            "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
            "linear-gradient(135deg, #6a11cb 0%, #2575fc 100%)",
            "linear-gradient(135deg, #ff0844 0%, #ffb199 100%)",
            "linear-gradient(135deg, #0093E9 0%, #80D0C7 100%)",
            "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
            "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)"
        };
        return colors[id % colors.Length];
    }

    string GetInitials(string firstName, string lastName)
    {
        var f = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "";
        var l = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "";
        return (f + l).ToUpper();
    }

    int CalculateAge(DateTime dob)
    {
        var age = DateTime.Today.Year - dob.Year;
        if (dob.Date > DateTime.Today.AddYears(-age)) age--;
        return age;
    }
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-5 fade-in-up">
        <div>
            <h2 class="mb-1 text-gradient fw-bold" style="font-size: 2rem;">
                <i class="fas fa-basketball-ball me-2 text-primary"></i>Lot Jucători
            </h2>
            <p class="text-muted fw-medium fs-5">Vizualizează și gestionează performanța atleților.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm glass-card fade-in-up" style="animation-delay: 0.1s;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light bg-opacity-50 text-uppercase text-muted small">
                        <tr>
                            <th class="ps-4">Jucător</th>
                            <th class="text-center">Nr. Tricou</th>
                            <th>Poziție</th>
                            <th>Fizic (H / W)</th>
                            <th>Vârstă</th>
                            <th>Status Jucător</th>
                            <th class="text-end pe-4">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="player-row">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle shadow-sm me-3" style="background: @GetAvatarColor(item.PlayerId)">
                                            @GetInitials(item.Staff.FirstName, item.Staff.LastName)
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.Staff.LastName @item.Staff.FirstName</h6>
                                            <small class="text-muted">Exp: @item.Staff.ExperienceYears ani</small>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-light text-dark border border-secondary border-opacity-25 fs-6 shadow-sm">
                                        #@item.JerseyNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10 px-3 py-2 rounded-pill">
                                        @item.Position
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex flex-column small">
                                        <span class="text-dark fw-bold">@item.Height cm</span>
                                        <span class="text-muted">@item.Weight kg</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="text-dark">@CalculateAge(item.Staff.DateOfBirth) ani</span>
                                </td>

                                <td>
                                    @{
                                        bool hasActiveContract = item.Staff?.Contracts != null && item.Staff.Contracts.Any(c => c.IsActive && c.EndDate >= DateTime.Now);
                                        bool isClearanceValid = item.LastMedicalClearance.HasValue && item.LastMedicalClearance.Value.AddMonths(8) >= DateTime.Now;
                                        bool isInjured = item.Injuries != null && item.Injuries.Any(i => i.Status != "Recuperat");
                                    }

                                    @if (!hasActiveContract)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 py-2 shadow-sm pulse-danger">
                                            <i class="fas fa-file-contract me-1"></i>Fără Contract
                                        </span>
                                    }
                                    else if (!isClearanceValid)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 py-2 shadow-sm pulse-danger">
                                            <i class="fas fa-ban me-1"></i>Lipsă Viză
                                        </span>
                                    }
                                    else if (isInjured)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-2 shadow-sm pulse-danger">
                                            <i class="fas fa-band-aid me-1"></i>Accidentat
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2 shadow-sm">
                                            <i class="fas fa-check-circle me-1"></i>Apt de Joc
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-route-id="@item.PlayerId" class="btn btn-icon btn-light text-info" title="Vezi Profil">
                                            <i class="fas fa-id-card"></i>
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.PlayerId" class="btn btn-icon btn-light text-primary" title="Editează">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.PlayerId" class="btn btn-icon btn-light text-danger" title="Șterge">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="icon-circle bg-light text-muted mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="fas fa-basketball-ball"></i>
                    </div>
                    <p class="text-muted">Nu există jucători înregistrați în baza de date.</p>
                </div>
            }
        </div>
    </div>
</div>

