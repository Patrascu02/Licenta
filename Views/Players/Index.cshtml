@model IEnumerable<Licenta.Models.Roles.Player>

@{
    ViewData["Title"] = "Lotul de Jucători";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users text-primary"></i> Lotul de Jucători</h2>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nume</th>
                        <th>Poziție</th>
                        <th>Număr</th>
                        <th class="text-end">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                @item.Staff.FirstName @item.Staff.LastName
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@item.Position</span>
                            </td>
                            <td>
                                <span class="fw-bold">#@item.JerseyNumber</span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Players" asp-action="Details" asp-route-id="@item.PlayerId" class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-eye"></i> Detalii
                                </a>

                                @if (User.HasClaim("Permission", "Scouting.Manage"))
                                {
                                    <a asp-controller="Scout" asp-action="AddMonthlyStats" asp-route-playerId="@item.PlayerId" class="btn btn-primary btn-sm">
                                        <i class="fas fa-chart-bar"></i> Adaugă Medii
                                    </a>
                                }

                                @if (User.HasClaim("Permission", "Players.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.PlayerId" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Editează
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>