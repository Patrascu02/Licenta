@model Licenta.Models.Roles.Player

@{
    ViewData["Title"] = "Detalii Jucător";
}

<div class="container mt-4">
    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="fas fa-user-graduate me-2"></i>@Model.Staff.FirstName @Model.Staff.LastName
            </h3>
            <span class="badge bg-light text-dark fs-6">#@Model.JerseyNumber | @Model.Position</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <p><strong>Înălțime:</strong> @Model.Height cm</p>
                    <p><strong>Greutate:</strong> @Model.Weight kg</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Echipa:</strong> @(Model.CurrentTeam?.Name ?? "Fără echipă")</p>
                    <p><strong>Data Nașterii:</strong> @Model.Staff.DateOfBirth.ToShortDateString()</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Experiență:</strong> @Model.Staff.ExperienceYears ani</p>
                    <p><strong>Angajat din:</strong> @Model.Staff.HireDate.ToShortDateString()</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Istoric Performanță (Rapoarte Scouting)</h5>
        </div>
        <div class="card-body">
            @if (Model.GameStats != null && Model.GameStats.Any(s => s.IsScoutingReport))
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Lună/An</th>
                                <th>Puncte</th>
                                <th>Recuperări</th>
                                <th>Pase</th>
                                <th>Intercepții</th>
                                <th>Capace</th>
                                <th>Minute</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in Model.GameStats.Where(s => s.IsScoutingReport).OrderByDescending(s => s.Year).ThenByDescending(s => s.Month))
                            {
                                <tr>
                                    <td><strong>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(stat.Month) @stat.Year</strong></td>
                                    <td>@stat.Points.ToString("F1")</td>
                                    <td>@stat.Rebounds.ToString("F1")</td>
                                    <td>@stat.Assists.ToString("F1")</td>
                                    <td>@stat.Steals.ToString("F1")</td>
                                    <td>@stat.Blocks.ToString("F1")</td>
                                    <td>@stat.MinutesPlayed.ToString("F1")'</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>Nu există încă rapoarte de scouting introduse pentru acest jucător.
                </div>
            }
        </div>
    </div>

    @if (User.IsInRole("GeneralManager"))
    {
        <div class="card shadow border-0 mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-file-contract me-2"></i>Situație Contractuală (Acces GM)</h5>
            </div>
            <div class="card-body">
                @if (Model.Staff.Contracts != null && Model.Staff.Contracts.Any())
                {
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Data Start</th>
                                <th>Data Final</th>
                                <th>Salariu</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contract in Model.Staff.Contracts.OrderByDescending(c => c.StartDate))
                            {
                                <tr class="@(contract.IsActive ? "table-success" : "")">
                                    <td>@contract.StartDate.ToShortDateString()</td>
                                    <td>@(contract.EndDate?.ToShortDateString() ?? "Nedeterminat")</td>
                                    <td>@contract.Salary.ToString("C0")</td>
                                    <td>
                                        @if (contract.IsActive)
                                        {
                                            <span class="badge bg-success">ACTIV</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">INACTIV</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">Nu există contracte înregistrate în sistem.</p>
                }
            </div>
        </div>
    }

    <div class="mt-4 mb-5">
        <a asp-action="Index" class="btn btn-secondary px-4">
            <i class="fas fa-arrow-left me-2"></i>Înapoi la listă
        </a>
    </div>
</div>