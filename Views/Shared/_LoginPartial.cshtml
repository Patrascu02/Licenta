@using Microsoft.AspNetCore.Identity
@using Licenta.Data
@using Microsoft.EntityFrameworkCore
@using Licenta.Models.Identity

@* Injectăm Managerii standard și Contextul Bazei de Date pentru a accesa Staff *@
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        // 1. Obținem utilizatorul logat (Identity)
        var user = await UserManager.GetUserAsync(User);

        if (user != null)
        {
            // 2. Căutăm profilul de STAFF asociat acestui cont
            var staff = await _context.Staff.FirstOrDefaultAsync(s => s.UserId == user.Id);

            // 3. Determinăm Numele de Afișat (Din Staff sau Email de rezervă)
            string displayName = (staff != null && !string.IsNullOrEmpty(staff.FirstName))
            ? $"{staff.FirstName} {staff.LastName}"
            : user.Email;

            // 4. Generăm Inițialele (Ex: "IP" pentru Ion Popescu)
            string initials = "U";
            if (staff != null && !string.IsNullOrEmpty(staff.FirstName) && !string.IsNullOrEmpty(staff.LastName))
            {
                initials = $"{staff.FirstName[0]}{staff.LastName[0]}".ToUpper();
            }
            else if (!string.IsNullOrEmpty(user.Email))
            {
                initials = user.Email.Substring(0, 1).ToUpper();
            }

            // 5. Obținem Rolul (pentru afișare)
            var roles = await UserManager.GetRolesAsync(user);
            var roleName = roles.FirstOrDefault() ?? "Utilizator";

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 cyber-profile-link" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">

                    <div class="cyber-avatar">
                        <span>@initials</span>
                    </div>

                    <div class="d-none d-md-block lh-1 text-start">
                        <span class="d-block fw-bold text-neon-small">@displayName</span>
                        <span class="small text-muted" style="font-size: 0.7rem;">@roleName</span>
                    </div>
                </a>

                <ul class="dropdown-menu dropdown-menu-end cyber-dropdown" aria-labelledby="userDropdown">

                    <li class="px-3 py-3 border-bottom border-secondary mb-2 text-center">
                        <div class="cyber-avatar mx-auto mb-2" style="width: 50px; height: 50px; font-size: 1.2rem;">
                            <span>@initials</span>
                        </div>
                        <span class="d-block fw-bold text-white">@displayName</span>
                        <small class="text-muted">@user.Email</small>
                    </li>

                    <li>
                        <a class="dropdown-item cyber-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <i class="fas fa-id-card me-2 text-info"></i>Profilul Meu
                        </a>
                    </li>

                    @if (User.IsInRole("Admin") || User.IsInRole("GeneralManager"))
                    {
                        <li>
                            <a class="dropdown-item cyber-item" asp-controller="Admin" asp-action="AdminDashboard">
                                <i class="fas fa-tachometer-alt me-2 text-success"></i>Dashboard
                            </a>
                        </li>
                    }

                    <li><hr class="dropdown-divider bg-secondary opacity-50 my-2"></li>

                    <li>
                        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button id="logout" type="submit" class="dropdown-item cyber-item text-danger">
                                <i class="fas fa-power-off me-2"></i>Deconectare
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        }
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-uppercase fw-bold mx-2 cyber-link" id="register" asp-area="Identity" asp-page="/Account/Register">
                <i class="fas fa-user-plus me-1"></i> Înregistrare
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm ms-2 px-3 fw-bold mt-1 cyber-btn-glow" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="fas fa-sign-in-alt me-1"></i> Autentificare
            </a>
        </li>
    }
</ul>