@model IEnumerable<Licenta.Models.Security.AuditLog>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-primary">
                <i class="fas fa-chalkboard-teacher me-2"></i>Consolă Administrare
            </h2>
            <p class="text-muted">Gestionarea utilizatorilor și monitorizarea activității clubului.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ManageRoles" class="btn btn-warning text-dark shadow-sm ms-2">
                <i class="fas fa-user-shield me-2"></i>Permisiuni & Roluri
            </a>
            <a asp-action="CreateUser" class="btn btn-primary shadow-sm">
                <i class="fas fa-user-plus me-2"></i>Creează Utilizator
            </a>
            <button class="btn btn-outline-secondary shadow-sm" onclick="window.location.reload();">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card bg-admin-primary h-100 shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75 fw-bold small">Total Utilizatori</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalUsers</h2>
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card bg-admin-light h-100 shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75 fw-bold small">Jucători Activi</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalPlayers</h2>
                    <i class="fas fa-running"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card bg-admin-dark h-100 shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75 fw-bold small">Antrenori/Staff</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalCoaches</h2>
                    <i class="fas fa-clipboard-list"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card bg-admin-accent h-100 shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75 fw-bold small">Audit Log-uri</h6>
                    <h2 class="display-5 fw-bold mb-0">@Model?.Count()</h2>
                    <i class="fas fa-shield-alt"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-lg-9 mb-4">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-fingerprint text-primary me-2"></i>Audit - Activitate Recentă
                    </h5>
                    <a href="#" class="btn btn-sm btn-light text-primary fw-bold">Vezi tot istoricul</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Angajat (ID)</th>
                                    <th>Acțiune Realizată</th>
                                    <th>Data și Ora</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var log in Model)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">#@log.StaffId</td>
                                            <td>
                                                <span class="text-dark fw-medium">@log.Action</span>
                                            </td>
                                            <td class="text-muted small">@log.Timestamp.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill bg-soft-success">Succes</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                                            <p>Nu a fost detectată nicio activitate recentă în sistem.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card shadow border-0 border-top border-primary border-4 mb-4">
                <div class="card-body">
                    <h6 class="fw-bold text-dark mb-4"><i class="fas fa-server text-primary me-2"></i>Monitorizare Sistem</h6>

                    <div class="d-flex justify-content-between align-items-center mb-3 small">
                        <span class="text-muted">Server Status:</span>
                        <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Online</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 small">
                        <span class="text-muted">Bază de Date:</span>
                        <span class="text-success fw-bold"><i class="fas fa-database me-1"></i> Activă</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 small">
                        <span class="text-muted">Securitate SSL:</span>
                        <span class="text-primary fw-bold"><i class="fas fa-lock me-1"></i> Securizat</span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between align-items-center small">
                        <span class="text-muted">Versiune App:</span>
                        <span class="badge bg-light text-dark border">v1.0.2-Stable</span>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0 bg-light">
                <div class="card-body p-3">
                    <p class="small text-muted mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        ID-ul de angajat afișat în log-uri corespunde cheii primare din tabelul Staff.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-success {
        background-color: rgba(25, 135, 84, 0.1) !important;
        color: #198754 !important;
    }

    .table thead th {
        font-size: 0.7rem;
        letter-spacing: 1px;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 71, 161, 0.02);
        cursor: default;
    }
</style>