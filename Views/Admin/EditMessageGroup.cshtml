@model Licenta.Models.ViewModels.EditMessageGroupViewModel
@{
    ViewData["Title"] = "Editare Grup";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold mb-0"><i class="fas fa-edit me-2"></i>Editare Grup: @Model.Name</h2>
        <a asp-action="ManageMessageGroups" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi</a>
    </div>

    <div class="card glass-card border-warning">
        <div class="card-body p-4">
            <form asp-action="EditMessageGroup" method="post">
                <input type="hidden" asp-for="GroupId" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label class="form-label text-white fw-bold">Numele Grupului</label>
                    <input asp-for="Name" class="form-control form-control-lg bg-dark text-warning border-warning" required />
                </div>

                <h5 class="text-white mb-3 border-bottom border-secondary pb-2">Adaugă sau Elimină Membri</h5>

                <div class="row g-3">
                    @for (int i = 0; i < Model.AvailableStaff.Count; i++)
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="form-check p-3 bg-dark bg-opacity-50 border border-secondary rounded hover-glow @(Model.AvailableStaff[i].IsSelected ? "border-warning bg-opacity-100" : "")">
                                <input type="hidden" asp-for="AvailableStaff[i].StaffId" />
                                <input type="hidden" asp-for="AvailableStaff[i].FullName" />
                                <input type="hidden" asp-for="AvailableStaff[i].RoleName" />

                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="AvailableStaff[i].IsSelected" id="check_@i" style="width: 1.2em; height: 1.2em; cursor:pointer;" />
                                <label class="form-check-label w-100" for="check_@i" style="cursor:pointer;">
                                    <span class="d-block text-white fw-bold">@Model.AvailableStaff[i].FullName</span>
                                    <small class="text-info">@Model.AvailableStaff[i].RoleName</small>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-5 text-end border-top border-secondary pt-3">
                    <button type="submit" class="btn btn-cyber px-5 py-2 fw-bold fs-5">
                        <i class="fas fa-save me-2"></i>Salvează Modificările
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
