@using Licenta.Models.ViewModels
@model IEnumerable<UserManagementViewModel>

@{
    ViewData["Title"] = "Gestiune Utilizatori";

    string GetAvatarColor(int id)
    {
        var colors = new[] {
            "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
            "linear-gradient(135deg, #6a11cb 0%, #2575fc 100%)",
            "linear-gradient(135deg, #ff0844 0%, #ffb199 100%)",
            "linear-gradient(135deg, #0093E9 0%, #80D0C7 100%)",
            "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
            "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)"
        };
        return colors[id % colors.Length];
    }

    string GetInitials(string firstName, string lastName)
    {
        var f = !string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "";
        var l = !string.IsNullOrEmpty(lastName) ? lastName[0].ToString() : "";
        return (f + l).ToUpper();
    }
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-5 fade-in-up">
        <div>
            <h2 class="mb-1 text-gradient" style="font-size: 2rem;">
                <i class="fas fa-users-cog me-2 text-primary"></i>Gestiune Utilizatori
            </h2>
            <p class="text-muted fw-medium fs-5">Administrează conturile și rolurile membrilor.</p>
        </div>
        <a asp-action="CreateUser" class="btn btn-primary shadow-lg hover-lift">
            <i class="fas fa-user-plus me-2"></i> Adaugă Utilizator
        </a>
    </div>

    <ul class="nav nav-pills mb-4 p-2 rounded-pill bg-white bg-opacity-50 border border-light shadow-sm d-inline-flex" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="tab-all" data-bs-toggle="pill" data-bs-target="#all" type="button" role="tab">
                <i class="fas fa-list me-2"></i>Toți
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="tab-players" data-bs-toggle="pill" data-bs-target="#players" type="button" role="tab">
                <i class="fas fa-basketball-ball me-2"></i>Jucători
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="tab-staff" data-bs-toggle="pill" data-bs-target="#staff" type="button" role="tab">
                <i class="fas fa-user-tie me-2"></i>Staff Tehnic
            </button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">

        <div class="tab-pane fade show active" id="all" role="tabpanel">
            <div class="card border-0 shadow-sm glass-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light bg-opacity-50 text-uppercase text-muted small">
                                <tr>
                                    <th class="ps-4">Utilizator</th>
                                    <th>Rol</th>
                                    <th>Email</th>
                                    <th class="text-end pe-4">Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="user-row">
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle shadow-sm me-3" style="background: @GetAvatarColor(item.StaffMember.StaffId)">
                                                    @GetInitials(item.StaffMember.FirstName, item.StaffMember.LastName)
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">@item.StaffMember.LastName @item.StaffMember.FirstName</h6>
                                                    <small class="text-muted">ID: #@item.StaffMember.StaffId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.RoleName == "GeneralManager")
                                            {
                                                <span class="badge role-badge role-gm">General Manager</span>
                                            }
                                            else if (item.RoleName == "Coach")
                                            {

                                                <span class="badge role-badge role-coach">Antrenor</span>
                                            }
                                            else if (item.RoleName == "Player")
                                            {

                                                <span class="badge role-badge role-player">Jucător</span>
                                            }
                                            else if (item.RoleName == "Medic")
                                            {

                                                <span class="badge role-badge role-medic">Medic</span>
                                            }
                                            else if (item.RoleName == "Scout")
                                            {

                                                <span class="badge role-badge role-scout">Scouter</span>
                                            }
                                            else
                                            {

                                                <span class="badge role-badge bg-secondary">@item.RoleName</span>
                                            }
                                        </td>
                                        <td class="text-muted">@item.Email</td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-primary" title="Editează"><i class="fas fa-edit"></i></a>
                                                <a asp-action="ManageUserPermissions" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-info" title="Permisiuni"><i class="fas fa-key"></i></a>
                                                @if (User.IsInRole("GeneralManager"))
                                                {
                                                    <a asp-controller="Contracts" asp-action="Create" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-success" title="Contract"><i class="fas fa-file-invoice-dollar"></i></a>
                                                }

                                                <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post"
                                                      class="d-inline delete-form"
                                                      data-bs-message="Ești sigur că vrei să ștergi utilizatorul <strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong>?">
                                                    <button type="submit" class="btn btn-icon btn-light text-danger" title="Șterge"><i class="fas fa-trash-alt"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="players" role="tabpanel">
            <div class="card border-0 shadow-sm glass-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light bg-opacity-50 text-uppercase text-muted small">
                                <tr>
                                    <th class="ps-4">Jucător</th>
                                    <th>Poziție</th>
                                    <th>Nr.</th>
                                    <th>Înălțime</th>
                                    <th class="text-end pe-4">Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Where(u => u.RoleName == "Player"))
                                {
                                    <tr class="user-row">
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle shadow-sm me-3" style="background: @GetAvatarColor(item.StaffMember.StaffId)">
                                                    @GetInitials(item.StaffMember.FirstName, item.StaffMember.LastName)
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">@item.StaffMember.LastName @item.StaffMember.FirstName</h6>
                                                    <span class="badge role-badge role-player scale-sm">Jucător Activ</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="fw-bold text-dark">@(item.StaffMember.Player?.Position ?? "-")</span></td>
                                        <td><span class="fw-bold text-secondary fs-5">#@(item.StaffMember.Player?.JerseyNumber ?? 0)</span></td>
                                        <td>@(item.StaffMember.Player?.Height ?? 0) cm</td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-primary" title="Editează"><i class="fas fa-edit"></i></a>
                                                <a asp-action="ManageUserPermissions" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-info" title="Permisiuni"><i class="fas fa-key"></i></a>

                                                @if (User.IsInRole("GeneralManager"))
                                                {
                                                    <a asp-controller="Contracts" asp-action="Create" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-success" title="Contract"><i class="fas fa-file-invoice-dollar"></i></a>
                                                }

                                                <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post"
                                                      class="d-inline delete-form"
                                                      data-bs-message="Ești sigur că vrei să ștergi jucătorul <strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong>?">
                                                    <button type="submit" class="btn btn-icon btn-light text-danger" title="Șterge"><i class="fas fa-trash-alt"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="staff" role="tabpanel">
            <div class="card border-0 shadow-sm glass-card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light bg-opacity-50 text-uppercase text-muted small">
                                <tr>
                                    <th class="ps-4">Membru Staff</th>
                                    <th>Funcție / Rol</th>
                                    <th>Dată Angajare</th>
                                    <th class="text-end pe-4">Acțiuni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Where(u => u.RoleName != "Player"))
                                {
                                    <tr class="user-row">
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle shadow-sm me-3" style="background: @GetAvatarColor(item.StaffMember.StaffId)">
                                                    @GetInitials(item.StaffMember.FirstName, item.StaffMember.LastName)
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">@item.StaffMember.LastName @item.StaffMember.FirstName</h6>
                                                    <small class="text-muted">@item.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.RoleName == "GeneralManager")
                                            {
                                                <span class="badge role-badge role-gm">General Manager</span>
                                            }
                                            else if (item.RoleName == "Coach")
                                            {

                                                <span class="badge role-badge role-coach">Antrenor</span>
                                            }
                                            else if (item.RoleName == "Medic")
                                            {

                                                <span class="badge role-badge role-medic">Medic</span>
                                            }
                                            else if (item.RoleName == "Scout")
                                            {

                                                <span class="badge role-badge role-scout">Scouter</span>
                                            }
                                            else
                                            {

                                                <span class="badge role-badge bg-secondary">@item.RoleName</span>
                                            }
                                        </td>
                                        <td class="text-muted">
                                            <i class="far fa-calendar-alt me-1"></i> @item.StaffMember.HireDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-primary" title="Editează"><i class="fas fa-edit"></i></a>
                                                <a asp-action="ManageUserPermissions" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-icon btn-light text-info" title="Permisiuni"><i class="fas fa-key"></i></a>

                                                <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post"
                                                      class="d-inline delete-form"
                                                      data-bs-message="Ești sigur că vrei să ștergi membrul staff <strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong>?">
                                                    <button type="submit" class="btn btn-icon btn-light text-danger" title="Șterge"><i class="fas fa-trash-alt"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal border-0">
            <div class="modal-body p-4 text-center">
                <div class="mb-4">
                    <div class="icon-circle-danger mx-auto shadow-sm">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                    </div>
                </div>

                <h4 class="fw-bold text-dark mb-2">Confirmare Ștergere</h4>
                <p class="text-muted mb-4" id="deleteModalMessage">Ești sigur?</p>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light border px-4 fw-bold rounded-pill" data-bs-dismiss="modal">
                        Nu, Anulează
                    </button>
                    <button type="button" id="confirmDeleteBtn" class="btn btn-danger px-4 fw-bold rounded-pill shadow-lg hover-scale">
                        Da, Șterge!
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link {
        color: #334155 !important;
        font-weight: 600;
        background-color: rgba(255, 255, 255, 0.6);
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

        .nav-pills .nav-link.active {
            background: var(--primary-gradient) !important;
            color: white !important;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
            border-color: transparent;
        }

    .role-badge {
        padding: 0.5em 1em;
        font-weight: 600;
        letter-spacing: 0.5px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .role-player {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: white;
    }

    .role-coach {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
    }

    .role-gm {
        background: linear-gradient(135deg, #4c1d95 0%, #312e81 100%);
        color: #e0e7ff;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .role-medic {
        background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
        color: white;
    }

    .role-scout {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
    }

    .scale-sm {
        transform: scale(0.9);
        display: inline-block;
    }

    .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        text-shadow: 0 1px 2px rgba(0,0,0,0.2);
        border: 2px solid white;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
    }

    .btn-icon {
        width: 35px;
        height: 35px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: all 0.2s;
        border: 1px solid rgba(0,0,0,0.05);
    }

        .btn-icon:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            background-color: white;
        }

    .user-row {
        transition: all 0.2s ease;
    }

        .user-row:hover {
            background-color: white;
            transform: scale(1.005);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            z-index: 10;
            position: relative;
        }

    .fade-in-up {
        animation: fadeInUp 0.8s ease-out;
    }

    .glass-modal {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    }

    .icon-circle-danger {
        width: 80px;
        height: 80px;
        background: #fef2f2; 
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid #fff;
    }

    .hover-scale:hover {
        transform: scale(1.05);
        transition: transform 0.2s;
    }

    .modal-backdrop.show {
        backdrop-filter: blur(5px);
        opacity: 0.3;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            let formToSubmit = null;

            // 1. Interceptăm submit-ul formularului de ștergere
            $('.delete-form').on('submit', function (e) {
                e.preventDefault(); // Oprește acțiunea default

                formToSubmit = this; // Salvăm formularul curent

                // Preluăm mesajul personalizat
                var message = $(this).attr('data-bs-message');
                $('#deleteModalMessage').html(message);

                // Deschidem modala
                var myModal = new bootstrap.Modal(document.getElementById('deleteConfirmationModal'));
                myModal.show();
            });

            // 2. Acțiune buton confirmare
            $('#confirmDeleteBtn').on('click', function () {
                if (formToSubmit) {
                    formToSubmit.submit(); // Trimitem formularul
                }
            });
        });
    </script>
}