@using Licenta.Models.ViewModels
@model IEnumerable<UserManagementViewModel>

@{
    ViewData["Title"] = "Gestiune Conturi";
}

<style>
    .nav-pills .nav-link {
        color: #333 !important;
        background-color: #f1f1f1;
        margin-right: 8px;
        border: 1px solid #ccc;
        font-weight: 500;
        transition: all 0.2s;
    }

        .nav-pills .nav-link:hover {
            background-color: #e2e2e2;
            color: #000 !important;
        }

        .nav-pills .nav-link.active {
            background-color: #0d6efd !important;
            color: #ffffff !important;
            border-color: #0d6efd;
        }

    .table-responsive {
        margin-top: 20px;
    }

    .badge-role {
        min-width: 100px; /* Lățime fixă pentru aliniere frumoasă */
        font-weight: 500;
        padding: 8px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-users-cog me-2 text-primary"></i>Gestiune Utilizatori</h2>
        <a asp-action="CreateUser" class="btn btn-primary shadow-sm">
            <i class="fas fa-user-plus me-1"></i> Adaugă Utilizator Nou
        </a>
    </div>

    <ul class="nav nav-pills mb-3 p-2 bg-white rounded border shadow-sm" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-all" data-bs-toggle="pill" data-bs-target="#all" type="button" role="tab"><i class="fas fa-list me-1"></i> Toți</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-players" data-bs-toggle="pill" data-bs-target="#players" type="button" role="tab"><i class="fas fa-basketball-ball me-1"></i> Jucători</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-staff" data-bs-toggle="pill" data-bs-target="#staff" type="button" role="tab"><i class="fas fa-user-tie me-1"></i> Staff</button>
        </li>
    </ul>

    <div class="tab-content bg-white p-3 border rounded shadow-sm" id="pills-tabContent">

        <div class="tab-pane fade show active" id="all" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light"><tr><th>Nume</th><th>Rol</th><th>Email</th><th class="text-end">Acțiuni</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong></td>
                                <td>
                                    @if (item.RoleName == "GeneralManager")
                                    {
                                        <span class="badge bg-dark badge-role">General Manager</span>
                                    }
                                    else if (item.RoleName == "Coach")
                                    {
                                        <span class="badge bg-warning text-dark badge-role">Antrenor</span>
                                    }
                                    else if (item.RoleName == "Player")
                                    {
                                        <span class="badge bg-primary badge-role">Jucător</span>
                                    }
                                    else if (item.RoleName == "Medic")
                                    {
                                        <span class="badge bg-danger badge-role">Medic</span>
                                    }
                                    else if (item.RoleName == "Scout")
                                    {
                                        <span class="badge bg-info text-dark badge-role">Scouter</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary badge-role">@item.RoleName</span>
                                    }
                                </td>
                                <td>@item.Email</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-outline-primary" title="Editează"><i class="fas fa-edit"></i></a>

                                        <a asp-action="ManageUserPermissions" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-outline-info text-dark" title="Permisiuni Speciale">
                                            <i class="fas fa-key"></i>
                                        </a>

                                        <a asp-controller="Contracts" asp-action="Create" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-outline-success" title="Adaugă Contract">
                                            <i class="fas fa-file-invoice-dollar"></i>
                                        </a>

                                        <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post" onsubmit="return confirm('Sigur dorești să ștergi acest utilizator?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger" title="Șterge"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="players" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light"><tr><th>Nume</th><th>Poziție</th><th>Nr.</th><th>Înălțime</th><th class="text-end">Acțiuni</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Where(u => u.RoleName == "Player"))
                        {
                            <tr>
                                <td><strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong></td>
                                <td><span class="badge bg-info text-dark">@(item.StaffMember.Player?.Position ?? "N/A")</span></td>
                                <td>#@(item.StaffMember.Player?.JerseyNumber ?? 0)</td>
                                <td>@(item.StaffMember.Player?.Height ?? 0) cm</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>

                                        <a asp-controller="Contracts" asp-action="Create" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-outline-success" title="Contract">
                                            <i class="fas fa-file-invoice-dollar"></i>
                                        </a>

                                        <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post" onsubmit="return confirm('Ștergi jucătorul?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="staff" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light"><tr><th>Nume</th><th>Rol</th><th>Email</th><th class="text-end">Acțiuni</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Where(u => u.RoleName != "Player"))
                        {
                            <tr>
                                <td><strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong></td>
                                <td>
                                    @if (item.RoleName == "GeneralManager")
                                    {
                                        <span class="badge bg-dark badge-role">General Manager</span>
                                    }
                                    else if (item.RoleName == "Coach")
                                    {
                                        <span class="badge bg-warning text-dark badge-role">Antrenor</span>
                                    }
                                    else if (item.RoleName == "Medic")
                                    {
                                        <span class="badge bg-danger badge-role">Medic</span>
                                    }
                                    else if (item.RoleName == "Scout")
                                    {
                                        <span class="badge bg-info text-dark badge-role">Scouter</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary badge-role">@item.RoleName</span>
                                    }
                                </td>
                                <td>@item.Email</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-outline-primary"><i class="fas fa-edit"></i></a>

                                        <a asp-controller="Contracts" asp-action="Create" asp-route-staffId="@item.StaffMember.StaffId" class="btn btn-outline-success" title="Contract">
                                            <i class="fas fa-file-invoice-dollar"></i>
                                        </a>

                                        <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post" onsubmit="return confirm('Ștergi membrul staff?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>