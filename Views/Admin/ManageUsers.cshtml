@using Licenta.Models.ViewModels
@model IEnumerable<UserManagementViewModel>

@{
    ViewData["Title"] = "Gestiune Conturi";
}

<style>
    /* REPARARE VIZIBILITATE SCRIS TAB-URI */
    .nav-pills .nav-link {
        color: #333 !important; /* Scris închis la culoare pentru tab-uri inactive */
        background-color: #f1f1f1;
        margin-right: 8px;
        border: 1px solid #ccc;
        font-weight: 500;
        transition: all 0.2s;
    }

        .nav-pills .nav-link:hover {
            background-color: #e2e2e2;
            color: #000 !important;
        }

        .nav-pills .nav-link.active {
            background-color: #0d6efd !important; /* Albastru doar pentru cel activ */
            color: #ffffff !important; /* Scris alb doar pentru cel activ */
            border-color: #0d6efd;
        }

    .table-responsive {
        margin-top: 20px;
    }

    .badge-role {
        min-width: 80px;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-users-cog me-2 text-primary"></i>Gestiune Utilizatori</h2>
        <a asp-action="CreateUser" class="btn btn-primary shadow-sm">
            <i class="fas fa-user-plus me-1"></i> Adaugă Utilizator Nou
        </a>
    </div>

    <ul class="nav nav-pills mb-3 p-2 bg-white rounded border shadow-sm" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-all" data-bs-toggle="pill" data-bs-target="#all" type="button" role="tab">
                <i class="fas fa-list me-1"></i> Toți (Fără Admin)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-players" data-bs-toggle="pill" data-bs-target="#players" type="button" role="tab">
                <i class="fas fa-basketball-ball me-1"></i> Jucători
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-staff" data-bs-toggle="pill" data-bs-target="#staff" type="button" role="tab">
                <i class="fas fa-user-tie me-1"></i> Staff Tehnic
            </button>
        </li>
    </ul>

    <div class="tab-content bg-white p-3 border rounded shadow-sm" id="pills-tabContent">

        <div class="tab-pane fade show active" id="all" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nume Complet</th>
                            <th>Rol</th>
                            <th>Email</th>
                            <th class="text-end">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong></td>
                                <td><span class="badge bg-secondary badge-role">@item.RoleName</span></td>
                                <td>@item.Email</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-sm btn-outline-primary" title="Editează">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post"
                                              onsubmit="return confirm('Sigur vrei să ștergi acest utilizator?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Șterge">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="players" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nume</th>
                            <th>Poziție</th>
                            <th>Nr. Tricou</th>
                            <th>Înălțime</th>
                            <th class="text-end">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Where(u => u.RoleName == "Player"))
                        {
                            <tr>
                                <td><strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong></td>
                                <td><span class="badge bg-info text-dark">@(item.StaffMember.Player?.Position ?? "N/A")</span></td>
                                <td>#@(item.StaffMember.Player?.JerseyNumber ?? 0)</td>
                                <td>@(item.StaffMember.Player?.Height ?? 0) cm</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post"
                                              onsubmit="return confirm('Ștergi jucătorul?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="staff" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nume</th>
                            <th>Rol</th>
                            <th>Email</th>
                            <th class="text-end">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Where(u => u.RoleName != "Player"))
                        {
                            <tr>
                                <td><strong>@item.StaffMember.LastName @item.StaffMember.FirstName</strong></td>
                                <td><span class="badge bg-warning text-dark badge-role">@item.RoleName</span></td>
                                <td>@item.Email</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="EditUser" asp-route-id="@item.StaffMember.StaffId" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeleteUser" asp-route-id="@item.StaffMember.StaffId" method="post"
                                              onsubmit="return confirm('Ștergi membrul staff?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>