@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Roluri și Permisiuni";

    (string Class, string Icon) GetRoleStyle(string roleName)
    {
        return roleName switch
        {
            "GeneralManager" => ("role-gm", "fa-user-tie"),
            "Coach" => ("role-coach", "fa-clipboard-list"),
            "Player" => ("role-player", "fa-basketball-ball"),
            "Medic" => ("role-medic", "fa-user-md"),
            "Scout" => ("role-scout", "fa-binoculars"),
            _ => ("bg-secondary", "fa-user-shield") 
        };
    }
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-5 fade-in-up">
        <div>
            <h2 class="mb-1 text-gradient" style="font-size: 2rem;">
                <i class="fas fa-shield-alt me-2 text-primary"></i>Configurare Permisiuni
            </h2>
            <p class="text-muted fw-medium fs-5">Definește ce poate face fiecare rol în aplicație (ACL).</p>
        </div>
        <a asp-action="AdminDashboard" class="btn btn-outline-light text-dark border-0 shadow-sm hover-lift bg-white">
            <i class="fas fa-arrow-left me-2"></i>Înapoi la Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm glass-card fade-in-up" style="animation-delay: 0.1s;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light bg-opacity-50 text-uppercase text-muted small">
                        <tr>
                            <th class="ps-4">Denumire Rol</th>
                            <th>Identificator Sistem (ID)</th>
                            <th class="text-end pe-4">Configurare</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            var style = GetRoleStyle(role.Name);

                            <tr class="user-row">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-avatar shadow-sm me-3 @style.Class">
                                            <i class="fas @style.Icon"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark" style="font-size: 1.1rem;">@role.Name</h6>
                                            <small class="text-muted">Access Level Control</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace text-muted bg-light border rounded px-2 py-1 small">
                                        @role.Id
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="ManagePermissions" asp-route-roleId="@role.Id" class="btn btn-primary rounded-pill px-4 shadow-sm hover-scale">
                                        <i class="fas fa-sliders-h me-2"></i>Configurează
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-radius: 20px;
    }

    .icon-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px; 
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

    .user-row:hover .icon-avatar {
        transform: scale(1.1) rotate(-5deg);
    }

    .role-gm {
        background: linear-gradient(135deg, #4c1d95 0%, #312e81 100%);
    }

    .role-coach {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    }

    .role-player {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
    }

    .role-medic {
        background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
    }

    .role-scout {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    }

    .user-row {
        transition: all 0.2s ease;
        background: transparent;
    }

        .user-row:hover {
            background-color: white;
            transform: scale(1.005);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            z-index: 10;
            position: relative;
            border-radius: 12px;
        }

    .hover-scale {
        transition: transform 0.2s;
    }

        .hover-scale:hover {
            transform: translateY(-2px);
        }

    .hover-lift:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .fade-in-up {
        animation: fadeInUp 0.8s ease-out;
    }
</style>