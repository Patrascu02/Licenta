@model Licenta.Models.ViewModels.ManageRolePermissionsViewModel

@{
    ViewData["Title"] = "Configurare Permisiuni";

    // Funcție locală pentru stilizarea numelui rolului
    string GetRoleBadgeClass(string roleName)
    {
        return roleName switch
        {
            "GeneralManager" => "role-gm",
            "Coach" => "role-coach",
            "Player" => "role-player",
            "Medic" => "role-medic",
            "Scout" => "role-scout",
            _ => "bg-secondary"
        };
    }

    var badgeClass = GetRoleBadgeClass(Model.RoleName);
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="mb-1" style="font-size: 2rem;">
                <i class="fas fa-key me-2 text-primary"></i>Configurare Permisiuni
            </h2>
            <div class="d-flex align-items-center mt-2">
                <span class="text-muted fw-medium fs-5 me-2">Se editează accesul pentru:</span>
                <span class="badge @badgeClass shadow-sm px-3 py-2 rounded-pill border border-light border-opacity-25">
                    @Model.RoleName
                </span>
            </div>
        </div>
        <a asp-action="ManageRoles" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i>Înapoi la Roluri
        </a>
    </div>

    <div class="card glass-card">
        <div class="card-body p-0">
            <form asp-action="UpdatePermissions" method="post">
                <input type="hidden" asp-for="RoleId" />

                <div class="p-4 border-bottom border-secondary bg-dark bg-opacity-25">
                    <div class="d-flex align-items-center text-info">
                        <i class="fas fa-info-circle fs-4 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-1 text-info">Informații Control Acces</h6>
                            <p class="mb-0 small text-muted">Bifează acțiunile permise. Modificările se aplică imediat după salvare.</p>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-5 py-3" style="width: 30%;">Cod Permisiune</th>
                                <th style="width: 50%;">Descriere Funcțională</th>
                                <th class="text-center" style="width: 20%;">Stare</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PermissionList.Count; i++)
                            {
                                <tr class="border-bottom border-secondary">
                                    <td class="ps-5 py-3">
                                        <input type="hidden" asp-for="PermissionList[i].PermissionId" />
                                        <input type="hidden" asp-for="PermissionList[i].Name" />
                                        <input type="hidden" asp-for="PermissionList[i].Description" />

                                        <span class="badge bg-dark text-info border border-info font-monospace px-3 py-2">
                                            @Model.PermissionList[i].Name
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-light fw-medium">
                                            @Model.PermissionList[i].Description
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input asp-for="PermissionList[i].IsSelected" class="form-check-input" type="checkbox" role="switch" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-4 border-top border-secondary d-flex justify-content-end bg-dark bg-opacity-25">
                    <button type="submit" class="btn btn-cyber shadow px-5 py-2 fw-bold">
                        <i class="fas fa-save me-2"></i>Salvează Modificările
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Păstrăm DOAR culorile pentru badge-urile de rol */
    .role-gm {
        background: linear-gradient(135deg, #4c1d95 0%, #312e81 100%);
        color: #e0e7ff;
    }

    .role-coach {
        background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
        color: white;
    }

    .role-player {
        background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
        color: white;
    }

    .role-medic {
        background: linear-gradient(135deg, #be123c 0%, #9f1239 100%);
        color: white;
    }

    .role-scout {
        background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
        color: white;
    }
</style>