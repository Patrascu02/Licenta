@model Licenta.Models.ViewModels.ManageRolePermissionsViewModel

@{
    ViewData["Title"] = "Configurare Permisiuni";

    // Funcție locală pentru stilizarea numelui rolului
    string GetRoleBadgeClass(string roleName)
    {
        return roleName switch
        {
            "GeneralManager" => "role-gm",
            "Coach" => "role-coach",
            "Player" => "role-player",
            "Medic" => "role-medic",
            "Scout" => "role-scout",
            _ => "bg-secondary"
        };
    }

    var badgeClass = GetRoleBadgeClass(Model.RoleName);
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="mb-1 text-gradient" style="font-size: 2rem;">
                <i class="fas fa-key me-2 text-primary"></i>Configurare Permisiuni
            </h2>
            <div class="d-flex align-items-center mt-2">
                <span class="text-muted fw-medium fs-5 me-2">Se editează accesul pentru:</span>
                <span class="badge @badgeClass shadow-sm px-3 py-2 rounded-pill">
                    @Model.RoleName
                </span>
            </div>
        </div>
        <a asp-action="ManageRoles" class="btn btn-outline-light text-dark border-0 shadow-sm bg-white">
            <i class="fas fa-arrow-left me-2"></i>Înapoi la Roluri
        </a>
    </div>

    <div class="card border-0 shadow-sm glass-card">
        <div class="card-body p-0">
            <form asp-action="UpdatePermissions" method="post">
                <input type="hidden" asp-for="RoleId" />

                <div class="p-4 bg-primary bg-opacity-10 border-bottom border-light">
                    <div class="d-flex align-items-center text-primary">
                        <i class="fas fa-info-circle fs-4 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Informații Control Acces</h6>
                            <p class="mb-0 small opacity-75">Bifează acțiunile permise. Modificările se aplică imediat după salvare.</p>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light bg-opacity-50 text-uppercase text-muted small">
                            <tr>
                                <th class="ps-5 py-3" style="width: 30%;">Cod Permisiune</th>
                                <th style="width: 50%;">Descriere Funcțională</th>
                                <th class="text-center" style="width: 20%;">Stare</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PermissionList.Count; i++)
                            {
                                <tr class="user-row border-bottom border-light">
                                    <td class="ps-5 py-3">
                                        <input type="hidden" asp-for="PermissionList[i].PermissionId" />
                                        <input type="hidden" asp-for="PermissionList[i].Name" />
                                        <input type="hidden" asp-for="PermissionList[i].Description" />

                                        <span class="badge bg-light text-primary border border-primary border-opacity-25 font-monospace px-3 py-2">
                                            @Model.PermissionList[i].Name
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-dark fw-medium">
                                            @Model.PermissionList[i].Description
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input asp-for="PermissionList[i].IsSelected" class="form-check-input custom-switch" type="checkbox" role="switch" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-4 border-top border-light d-flex justify-content-end bg-light bg-opacity-25 rounded-bottom-4">
                    <button type="submit" class="btn btn-success shadow px-5 py-2 fw-bold rounded-pill">
                        <i class="fas fa-save me-2"></i>Salvează Modificările
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* === GLASSMORPHISM (Static) === */
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        overflow: hidden;
    }

    /* === CUSTOM SWITCH === */
    .custom-switch {
        width: 3.5rem !important;
        height: 1.75rem !important;
        cursor: pointer;
    }

    .form-check-input:checked {
        background-color: var(--success-color, #10b981);
        border-color: var(--success-color, #10b981);
    }

    /* === ROW STYLE (FĂRĂ HOVER EFECTE) === */
    .user-row {
        background-color: transparent;
        /* Am scos transition, transform, box-shadow */
    }

        /* Opțional: Doar o ușoară schimbare de fundal la hover pentru lizibilitate, dar fără mișcare */
        .user-row:hover {
            background-color: rgba(0,0,0,0.01);
        }

    /* === ROLE COLORS === */
    .role-gm {
        background: linear-gradient(135deg, #4c1d95 0%, #312e81 100%);
        color: #e0e7ff;
    }

    .role-coach {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
    }

    .role-player {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: white;
    }

    .role-medic {
        background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
        color: white;
    }

    .role-scout {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white;
    }
</style>