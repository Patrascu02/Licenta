@model IEnumerable<Licenta.Models.Communication.MessageGroup>
@{
    ViewData["Title"] = "Gestiune Grupuri Chat";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold mb-0"><i class="fas fa-users-cog me-2"></i>Grupuri de Mesaje</h2>
        <div>
            <a asp-action="CreateMessageGroup" class="btn btn-cyber me-2"><i class="fas fa-plus me-2"></i>Grup Nou</a>
            <a asp-action="AdminDashboard" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi</a>
        </div>
    </div>

    <div class="card glass-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-dark align-middle mb-0 bg-transparent">
                    <thead class="border-secondary">
                        <tr>
                            <th class="ps-4">Nume Grup</th>
                            <th>Nr. Membri</th>
                            <th>Data Creării</th>
                            <th class="text-end pe-4">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-white">
                                    <i class="fas fa-users text-info me-2"></i>@group.Name
                                </td>
                                <td><span class="badge bg-secondary">@group.Members.Count membri</span></td>
                                <td class="text-muted">@group.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditMessageGroup" asp-route-id="@group.GroupId" class="btn btn-sm btn-outline-info me-2">
                                        <i class="fas fa-edit"></i> Editează
                                    </a>

                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@group.GroupId">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Nu există grupuri create.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var group in Model)
{
    <div class="modal fade" id="deleteModal_@group.GroupId" tabindex="-1" aria-labelledby="deleteModalLabel_@group.GroupId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: #0f172a; border: 1px solid #ef4444; box-shadow: 0 0 25px rgba(239, 68, 68, 0.3);">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger fw-bold" id="deleteModalLabel_@group.GroupId">
                        <i class="fas fa-exclamation-triangle me-2"></i>Avertizare Securitate
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="fas fa-biohazard text-danger" style="font-size: 3.5rem; filter: drop-shadow(0 0 10px rgba(239,68,68,0.8));"></i>
                    </div>
                    <h4 class="text-white mb-3">Confirmare distrugere date</h4>
                    <p class="text-muted">
                        Ești pe cale să ștergi grupul <strong class="text-info fs-5">@group.Name</strong>.<br />
                        Această acțiune este ireversibilă și va șterge definitiv <strong>toate mesajele</strong> transmise în interiorul acestuia.
                    </p>
                </div>
                <div class="modal-footer border-secondary justify-content-center bg-dark bg-opacity-50">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-bold" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Anulare
                    </button>

                    <form asp-action="DeleteMessageGroup" asp-route-id="@group.GroupId" method="post">
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-lg" style="box-shadow: 0 0 15px rgba(239,68,68,0.5) !important;">
                            <i class="fas fa-trash-alt me-2"></i>Da, Șterge Grupul
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}