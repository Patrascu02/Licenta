@model Licenta.Models.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Creează Utilizator Nou";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-admin-primary text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-plus me-2"></i>Înregistrare Personal Nou</h4>
                </div>
                <div class="card-body p-4 bg-white">
                    <form asp-action="CreateUser" method="post" id="createUserForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="fas fa-lock me-2"></i>Informații Acces
                        </h6>
                        <div class="row mb-4">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Email" class="form-label small fw-bold text-muted text-uppercase">Email Oficial</label>
                                <div class="input-group">
                                    <input asp-for="Email" class="form-control border-2 shadow-sm" id="emailInput" placeholder="nume@club.ro" />
                                    <span class="input-group-text bg-white border-2 border-start-0">
                                        <i id="emailStatusIcon" class="fas fa-envelope text-muted"></i>
                                    </span>
                                </div>
                                <span id="emailErrorCustom" class="text-danger small fw-bold"></span>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Password" class="form-label small fw-bold text-muted text-uppercase">Parolă</label>
                                <div class="input-group">
                                    <input asp-for="Password" type="password" class="form-control border-2 border-end-0 shadow-sm" id="passwordInput" />
                                    <button class="btn btn-outline-secondary border-2 border-start-0 border-end-0 bg-white text-muted" type="button" id="togglePassword">
                                        <i class="fas fa-eye" id="eyeIcon"></i>
                                    </button>
                                    <span class="input-group-text bg-white border-2 border-start-0 shadow-sm">
                                        <i id="pwStatus" class="fas fa-times text-danger"></i>
                                    </span>
                                </div>
                                <div class="small text-muted mt-1" style="font-size: 0.7rem;">Min. 6 caractere, o cifră, o majusculă.</div>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted text-uppercase">Confirmă Parola</label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-2 border-end-0 shadow-sm" id="confirmPasswordInput" />
                                    <span class="input-group-text bg-white border-2 border-start-0 shadow-sm">
                                        <i id="confirmStatus" class="fas fa-times text-danger"></i>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">
                            <i class="fas fa-id-card me-2"></i>Date Personale & Contract
                        </h6>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label small fw-bold text-muted text-uppercase">Prenume</label>
                                <input asp-for="FirstName" class="form-control border-2 shadow-sm" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label small fw-bold text-muted text-uppercase">Nume</label>
                                <input asp-for="LastName" class="form-control border-2 shadow-sm" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Role" class="form-label small fw-bold text-muted text-uppercase">Rol Atribuit</label>
                                <select asp-for="Role" id="roleSelect" class="form-select border-2 shadow-sm">
                                    <option value="" disabled selected>Alege rolul...</option>
                                    <option value="Player">Jucător</option>
                                    <option value="Coach">Antrenor</option>
                                    <option value="Medic">Medic</option>
                                    <option value="Scout">Scouter</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="DateOfBirth" class="form-label small fw-bold text-muted text-uppercase">Data Nașterii</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control border-2 shadow-sm" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="HireDate" class="form-label small fw-bold text-muted text-uppercase">Data Angajării</label>
                                <input asp-for="HireDate" type="date" class="form-control border-2 shadow-sm" />
                            </div>
                        </div>

                        <div id="dynamicFieldsContainer">
                            <div id="playerFields" class="role-fields mb-4" style="display:none;">
                                <h6 class="text-info fw-bold mb-3 border-bottom pb-2"><i class="fas fa-basketball-ball me-2"></i>Detalii Jucător</h6>
                                <div class="row p-3 bg-light rounded shadow-sm border">
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label small fw-bold text-muted">POZIȚIE</label>
                                        <select asp-for="Position" class="form-select border-2">
                                            <option value="Point Guard">Point Guard (1)</option>
                                            <option value="Shooting Guard">Shooting Guard (2)</option>
                                            <option value="Small Forward">Small Forward (3)</option>
                                            <option value="Power Forward">Power Forward (4)</option>
                                            <option value="Center">Center (5)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label small fw-bold text-muted">NR. TRICOU</label>
                                        <input asp-for="JerseyNumber" type="number" class="form-control border-2" />
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label small fw-bold text-muted">ÎNĂLȚIME (cm)</label>
                                        <input asp-for="Height" type="number" class="form-control border-2" />
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label class="form-label small fw-bold text-muted">GREUTATE (kg)</label>
                                        <input asp-for="Weight" type="number" class="form-control border-2" />
                                    </div>
                                </div>
                            </div>

                            <div id="coachFields" class="role-fields mb-4" style="display:none;">
                                <h6 class="text-info fw-bold mb-3 border-bottom pb-2"><i class="fas fa-clipboard-list me-2"></i>Detalii Antrenor</h6>
                                <div class="row p-3 bg-light rounded shadow-sm border">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label small fw-bold text-muted">NUMĂR LICENȚĂ</label>
                                        <input asp-for="LicenseNumber" class="form-control border-2" placeholder="Ex: RO-BASKET-2024" />
                                    </div>
                                </div>
                            </div>

                            <div id="medicFields" class="role-fields mb-4" style="display:none;">
                                <h6 class="text-info fw-bold mb-3 border-bottom pb-2"><i class="fas fa-user-md me-2"></i>Detalii Medic</h6>
                                <div class="row p-3 bg-light rounded shadow-sm border">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label small fw-bold text-muted">SPECIALIZARE MEDICALĂ</label>
                                        <input asp-for="Specialization" class="form-control border-2" placeholder="Ex: Fizioterapie / Medicină Sportivă" />
                                    </div>
                                </div>
                            </div>

                            <div id="scoutFields" class="role-fields mb-4" style="display:none;">
                                <h6 class="text-info fw-bold mb-3 border-bottom pb-2"><i class="fas fa-search me-2"></i>Detalii Scouter</h6>
                                <div class="row p-3 bg-light rounded shadow-sm border">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label small fw-bold text-muted">REGIUNE MONITORIZATĂ</label>
                                        <input name="ScoutRegion" class="form-control border-2" placeholder="Ex: Europa de Est / Juniori U18" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" id="submitBtn" class="btn btn-primary px-5 shadow" disabled>
                                <i class="fas fa-save me-2"></i>Salvează Utilizatorul
                            </button>
                            <a asp-action="AdminDashboard" class="btn btn-light border px-4 shadow-sm">Anulează</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            const emailInput = $('#emailInput');
            const passwordInput = $('#passwordInput');
            const confirmInput = $('#confirmPasswordInput');
            const submitBtn = $('#submitBtn');
            const roleSelect = $('#roleSelect');

            let isEmailValid = false;

            // 1. AFIȘARE DINAMICĂ CÂMPURI ROL
            roleSelect.change(function () {
                const selectedRole = $(this).val();
                $('.role-fields').hide();

                if (selectedRole === 'Player') $('#playerFields').fadeIn();
                else if (selectedRole === 'Coach') $('#coachFields').fadeIn();
                else if (selectedRole === 'Medic') $('#medicFields').fadeIn();
                else if (selectedRole === 'Scout') $('#scoutFields').fadeIn();

                validateAll();
            });

            // 2. TOGGLE PAROLA
            $('#togglePassword').click(function() {
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                confirmInput.attr('type', type);
                $('#eyeIcon').toggleClass('fa-eye fa-eye-slash');
            });

            // 3. VERIFICARE EMAIL LIVE
            emailInput.on('blur input', function() {
                const email = $(this).val();
                if(email.length < 5) {
                    $('#emailStatusIcon').attr('class', 'fas fa-envelope text-muted');
                    return;
                }

                $.get('/Admin/CheckEmailExists', { email: email }, function(data) {
                    if (data.exists) {
                        $('#emailErrorCustom').text("Email deja folosit!");
                        $('#emailStatusIcon').attr('class', 'fas fa-times text-danger');
                        isEmailValid = false;
                    } else {
                        $('#emailErrorCustom').text("");
                        $('#emailStatusIcon').attr('class', 'fas fa-check text-success');
                        isEmailValid = true;
                    }
                    validateAll();
                });
            });

            // 4. VALIDARE GENERALĂ PENTRU ACTIVARE BUTON
            function validatePassword(pw) {
                return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}$/.test(pw);
            }

            function validateAll() {
                const pwVal = passwordInput.val();
                const confVal = confirmInput.val();

                const pwValid = validatePassword(pwVal);
                const matchValid = (confVal === pwVal && confVal !== "");
                const roleSelected = roleSelect.val() !== null;

                // Update UI Icons
                $('#pwStatus').attr('class', pwValid ? 'fas fa-check text-success' : 'fas fa-times text-danger');
                $('#confirmStatus').attr('class', matchValid ? 'fas fa-check text-success' : 'fas fa-times text-danger');

                // Enable/Disable Submit
                submitBtn.prop('disabled', !(pwValid && matchValid && isEmailValid && roleSelected));
            }

            passwordInput.on('keyup input', validateAll);
            confirmInput.on('keyup input', validateAll);
        });
    </script>
}