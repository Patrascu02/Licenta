@model Licenta.Models.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Creează Utilizator";
}

<div class="container-fluid py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="mb-1 text-gradient" style="font-size: 2rem;">
                <i class="fas fa-user-plus me-2 text-primary"></i>Utilizator Nou
            </h2>
            <p class="text-muted fw-medium fs-5">Înregistrează un nou membru în sistem.</p>
        </div>
        <a asp-action="AdminDashboard" class="btn btn-outline-light text-dark border-0 shadow-sm bg-white">
            <i class="fas fa-times me-2"></i>Anulează
        </a>
    </div>

    <form asp-action="CreateUser" method="post" id="createUserForm">

        <div asp-validation-summary="All" class="alert alert-danger shadow-sm border-danger bg-dark bg-opacity-50 text-danger fw-bold" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")">
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm glass-card h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h5 class="fw-bold text-dark"><i class="fas fa-id-card me-2 text-primary"></i>Date Personale și Cont</h5>
                    </div>
                    <div class="card-body p-4">

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control bg-white border" placeholder="Popescu" />
                                    <label asp-for="LastName" class="text-muted">Nume de Familie</label>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control bg-white border" placeholder="Ion" />
                                    <label asp-for="FirstName" class="text-muted">Prenume</label>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" id="emailInput" class="form-control bg-white border" placeholder="name@example.com" />
                            <label asp-for="Email" class="text-muted">Adresă Email</label>
                            <span asp-validation-for="Email" id="emailError" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating position-relative">
                                    <input asp-for="Password" class="form-control bg-white border password-field" placeholder="Parolă" type="password" style="padding-right: 40px;" />
                                    <label asp-for="Password" class="text-muted">Parolă</label>
                                    <span class="toggle-password position-absolute top-50 end-0 translate-middle-y me-3 text-muted" style="cursor: pointer; z-index: 10;">
                                        <i class="fas fa-eye"></i>
                                    </span>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating position-relative">
                                    <input asp-for="ConfirmPassword" class="form-control bg-white border password-field" placeholder="Confirmă" type="password" style="padding-right: 40px;" />
                                    <label asp-for="ConfirmPassword" class="text-muted">Confirmă Parola</label>
                                    <span class="toggle-password position-absolute top-50 end-0 translate-middle-y me-3 text-muted" style="cursor: pointer; z-index: 10;">
                                        <i class="fas fa-eye"></i>
                                    </span>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="border-light my-4">

                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Detalii HR</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="DateOfBirth" class="form-control bg-white border" type="date" />
                                    <label asp-for="DateOfBirth" class="text-muted">Data Nașterii</label>
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="HireDate" class="form-control bg-white border" type="date" />
                                    <label asp-for="HireDate" class="text-muted">Data Angajării</label>
                                    <span asp-validation-for="HireDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="d-flex flex-column gap-4 h-100">

                    <div class="card border-0 shadow-sm glass-card">
                        <div class="card-body p-4">
                            <label asp-for="Role" class="form-label fw-bold text-dark">Rol în Club</label>
                            <select asp-for="Role" class="form-select form-select-lg border-0 bg-primary bg-opacity-10 text-primary fw-bold mb-2" id="roleSelector">
                                <option value="" disabled selected>-- Selectează Rolul --</option>
                                <option value="Player">Jucător</option>
                                <option value="Coach">Antrenor</option>
                                <option value="Medic">Medic</option>
                                <option value="Scout">Scouter</option>
                                <option value="GeneralManager">General Manager</option>
                            </select>
                            <div class="form-text small"><i class="fas fa-info-circle me-1"></i>Selectarea rolului va debloca câmpurile specifice.</div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <div id="role-Player" class="role-section d-none">
                        <div class="card border-0 shadow-sm glass-card role-card-player h-100">
                            <div class="card-header bg-transparent border-0 pt-4 px-4">
                                <h5 class="fw-bold text-white"><i class="fas fa-basketball-ball me-2"></i>Fișă Jucător</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <label class="text-white-50 small text-uppercase">Poziție</label>
                                        <select asp-for="Position" class="form-select bg-white bg-opacity-25 border-0 text-white">
                                            <option class="text-dark" value="">- Alege -</option>
                                            <option class="text-dark" value="PG">Point Guard (PG)</option>
                                            <option class="text-dark" value="SG">Shooting Guard (SG)</option>
                                            <option class="text-dark" value="SF">Small Forward (SF)</option>
                                            <option class="text-dark" value="PF">Power Forward (PF)</option>
                                            <option class="text-dark" value="C">Center (C)</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="text-white-50 small text-uppercase">Nr. Tricou</label>
                                        <input asp-for="JerseyNumber" class="form-control bg-white bg-opacity-25 border-0 text-white" placeholder="23" />
                                        <span asp-validation-for="JerseyNumber" class="text-warning small fw-bold mt-1 d-block"></span>
                                    </div>
                                    <div class="col-6">
                                        <label class="text-white-50 small text-uppercase">Înălțime (cm)</label>
                                        <input asp-for="Height" class="form-control bg-white bg-opacity-25 border-0 text-white" placeholder="200" />
                                    </div>
                                    <div class="col-6">
                                        <label class="text-white-50 small text-uppercase">Greutate (kg)</label>
                                        <input asp-for="Weight" class="form-control bg-white bg-opacity-25 border-0 text-white" placeholder="95" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="role-Coach" class="role-section d-none">
                        <div class="card border-0 shadow-sm glass-card role-card-coach h-100">
                            <div class="card-header bg-transparent border-0 pt-4 px-4">
                                <h5 class="fw-bold text-white"><i class="fas fa-clipboard-list me-2"></i>Detalii Antrenor</h5>
                            </div>
                            <div class="card-body p-4">
                                <label class="text-white-50 small text-uppercase">Număr Licență</label>
                                <input asp-for="LicenseNumber" class="form-control bg-white bg-opacity-25 border-0 text-white" placeholder="LIC-2024-XXX" />
                            </div>
                        </div>
                    </div>

                    <div id="role-Medic" class="role-section d-none">
                        <div class="card border-0 shadow-sm glass-card role-card-medic h-100">
                            <div class="card-header bg-transparent border-0 pt-4 px-4">
                                <h5 class="fw-bold text-white"><i class="fas fa-user-md me-2"></i>Specializare</h5>
                            </div>
                            <div class="card-body p-4">
                                <label class="text-white-50 small text-uppercase">Specializare</label>
                                <input asp-for="Specialization" class="form-control bg-white bg-opacity-25 border-0 text-white" placeholder="ex: Kinetoterapie" />
                            </div>
                        </div>
                    </div>

                    <div id="role-GeneralManager" class="role-section d-none">
                        <div class="card border-0 shadow-sm glass-card role-card-gm h-100">
                            <div class="card-header bg-transparent border-0 pt-4 px-4">
                                <h5 class="fw-bold text-white"><i class="fas fa-building me-2"></i>Administrativ</h5>
                            </div>
                            <div class="card-body p-4">
                                <label class="text-white-50 small text-uppercase">Birou</label>
                                <input asp-for="Office" class="form-control bg-white bg-opacity-10 border border-white border-opacity-25 text-white" placeholder="ex: Executiv" />
                            </div>
                        </div>
                    </div>

                    <div id="role-Scout" class="role-section d-none">
                        <div class="card border-0 shadow-sm glass-card role-card-scout h-100">
                            <div class="card-header bg-transparent border-0 pt-4 px-4">
                                <h5 class="fw-bold text-white"><i class="fas fa-binoculars me-2"></i>Scouting</h5>
                            </div>
                            <div class="card-body p-4">
                                <p class="text-white opacity-75 mb-0">Nu sunt necesare detalii suplimentare.</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-lg rounded-3">
                            <i class="fas fa-check-circle me-2"></i>Creează Contul
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            function toggleRoleFields() {
                var selectedRole = $('#roleSelector').val();
                $('.role-section').addClass('d-none');
                if(selectedRole) {
                    $('#role-' + selectedRole).removeClass('d-none').hide().fadeIn(300);
                }
            }
            $('#roleSelector').change(toggleRoleFields);
            toggleRoleFields();

            $('.toggle-password').click(function () {
                var input = $(this).siblings('input');
                var icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            $('#emailInput').blur(function () {
                var email = $(this).val();
                var errorSpan = $('#emailError');
                if (email) {
                    $.ajax({
                        url: '@Url.Action("CheckEmailExists", "Admin")',
                        type: 'GET',
                        data: { email: email },
                        success: function (response) {
                            if (response.exists) {
                                errorSpan.text("Adresa de email este deja utilizată.");
                                $('#emailInput').addClass('is-invalid');
                            } else {
                                errorSpan.text("");
                                $('#emailInput').removeClass('is-invalid').addClass('is-valid');
                            }
                        }
                    });
                }
            });
        });
    </script>
}