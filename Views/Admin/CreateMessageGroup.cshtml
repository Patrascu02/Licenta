@model Licenta.Models.ViewModels.CreateMessageGroupViewModel
@{
    ViewData["Title"] = "Creare Grup Comunicații";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold mb-0"><i class="fas fa-users-cog me-2"></i>Creare Grup Nou</h2>
        <a asp-action="AdminDashboard" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi</a>
    </div>

    <div class="card glass-card">
        <div class="card-body p-4">
            <form asp-action="CreateMessageGroup" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label class="form-label text-white fw-bold">Numele Grupului (Ex: Echipa Medicală, Lot Principal)</label>
                    <input asp-for="Name" class="form-control form-control-lg bg-dark text-info border-info" placeholder="Introdu numele..." required />
                </div>

                <h5 class="text-white mb-3 border-bottom border-secondary pb-2">Selectează Membrii Grupului</h5>

                <div class="row g-3">
                    @for (int i = 0; i < Model.AvailableStaff.Count; i++)
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="form-check p-3 bg-dark bg-opacity-50 border border-secondary rounded hover-glow">
                                <input type="hidden" asp-for="AvailableStaff[i].StaffId" />
                                <input type="hidden" asp-for="AvailableStaff[i].FullName" />
                                <input type="hidden" asp-for="AvailableStaff[i].RoleName" />

                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="AvailableStaff[i].IsSelected" id="check_@i" style="width: 1.2em; height: 1.2em; cursor:pointer;" />
                                <label class="form-check-label w-100" for="check_@i" style="cursor:pointer;">
                                    <span class="d-block text-white fw-bold">@Model.AvailableStaff[i].FullName</span>
                                    <small class="text-info">@Model.AvailableStaff[i].RoleName</small>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-5 text-end border-top border-secondary pt-3">
                    <button type="submit" class="btn btn-cyber px-5 py-2 fw-bold fs-5">
                        <i class="fas fa-save me-2"></i>Salvează Grupul
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .hover-glow {
        transition: all 0.3s;
    }

        .hover-glow:hover {
            border-color: var(--neon-primary) !important;
            box-shadow: 0 0 10px rgba(6, 182, 212, 0.2);
            background-color: rgba(15, 23, 42, 0.8) !important;
        }
</style>