@model IEnumerable<Licenta.Models.Sports.Game>
@{
    ViewData["Title"] = "Rapoarte Tactice Meciuri";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold mb-0"><i class="fas fa-chart-pie me-2"></i>Rapoarte Tactice</h2>
        <a asp-action="Dashboard" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi la Panou</a>
    </div>

    <div class="card glass-card border-info">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-dark align-middle mb-0 bg-transparent text-center">
                    <thead class="border-secondary text-muted">
                        <tr>
                            <th class="text-start ps-4">Dată Meci</th>
                            <th>Tip Meci</th>
                            <th>Scor Final (Acasă - Deplasare)</th>
                            <th class="text-end pe-4">Acțiune</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var meci in Model)
                            {
                                <tr>
                                    <td class="text-start ps-4 fw-bold">
                                        <i class="far fa-calendar-alt text-muted me-2"></i>
                                        <span class="text-white">@meci.GameDate.ToString("dd MMM yyyy, HH:mm")</span>
                                    </td>
                                    <td class="text-info">@(string.IsNullOrEmpty(meci.GameType) ? "Meci Oficial" : meci.GameType)</td>
                                    <td>
                                        <span class="fs-5 fw-bold @(meci.HomeScore > meci.AwayScore ? "text-success" : "text-white")">@meci.HomeScore</span>
                                        <span class="mx-2 text-muted">-</span>
                                        <span class="fs-5 fw-bold @(meci.AwayScore > meci.HomeScore ? "text-success" : "text-white")">@meci.AwayScore</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ViewGameStats" asp-route-id="@meci.GameId" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye me-1"></i> Vezi Statistici
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="fas fa-basketball-ball fs-1 mb-3 opacity-25"></i>
                                    <h5 class="mb-0">Nu a fost jucat niciun meci încă.</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>