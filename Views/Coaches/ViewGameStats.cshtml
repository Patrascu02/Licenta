@model Licenta.Models.ViewModels.EditGameStatsViewModel
@{
    ViewData["Title"] = "Vizualizare Statistici Meci";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-info fw-bold mb-1"><i class="fas fa-clipboard-list me-2"></i>Raport Tactic</h2>
            <h6 class="text-muted ms-1">@Model.GameInfo</h6>
        </div>
        <a asp-action="TacticalReports" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi</a>
    </div>

    <div class="card glass-card border-secondary mb-4 text-center p-3">
        <h5 class="text-muted mb-2 text-uppercase">Scor Final</h5>
        <div class="d-flex justify-content-center align-items-center gap-4">
            <h2 class="text-success fw-bold mb-0">@Model.HomeScore</h2>
            <span class="text-muted fs-4">-</span>
            <h2 class="text-danger fw-bold mb-0">@Model.AwayScore</h2>
        </div>
    </div>

    <div class="card glass-card border-info">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 65vh; overflow-y: auto;">
                <table class="table table-hover table-dark align-middle mb-0 bg-transparent text-center">
                    <thead class="border-secondary text-info sticky-top" style="background-color: #0f172a;">
                        <tr>
                            <th class="text-start ps-4">Jucător</th>
                            <th>MIN</th>
                            <th>PCT</th>
                            <th>REC</th>
                            <th>PAS</th>
                            <th>INT</th>
                            <th>CAP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ps in Model.PlayerStats)
                        {
                            string rowClass = ps.MinutesPlayed == 0 ? "opacity-50" : "";

                            <tr class="@rowClass">
                                <td class="text-start ps-4">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-secondary me-2" style="min-width:35px;">#@ps.JerseyNumber</span>
                                        <span class="fw-bold text-white">@ps.PlayerName</span>
                                        <span class="badge border border-secondary text-muted ms-2" style="font-size:0.6rem;">@ps.Position</span>
                                    </div>
                                </td>
                                <td class="text-warning fw-bold">@ps.MinutesPlayed</td>
                                <td class="text-success fw-bold fs-6">@ps.Points</td>
                                <td>@ps.Rebounds</td>
                                <td>@ps.Assists</td>
                                <td>@ps.Steals</td>
                                <td>@ps.Blocks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>