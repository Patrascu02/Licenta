@model Licenta.Models.ViewModels.CreateEventViewModel
@{
    ViewData["Title"] = "Eveniment Nou";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold mb-0"><i class="fas fa-calendar-plus me-2"></i>Planificare Nouă</h2>
        <a asp-action="Calendar" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Anulează</a>
    </div>

    <div class="row">
        <div class="col-lg-6 col-md-8">
            <div class="card glass-card border-success">
                <div class="card-body p-4">
                    <form asp-action="CreateEvent" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="RelatedEntity" class="form-label text-white fw-bold"></label>
                            <select asp-for="RelatedEntity" class="form-select bg-dark text-white border-secondary">
                                <option value="Antrenament Fizic">Antrenament Fizic</option>
                                <option value="Antrenament Tactic">Antrenament Tactic (Teren)</option>
                                <option value="Analiză Video">Analiză Video / Ședință</option>
                                <option value="Recuperare">Sesiune Recuperare</option>
                                <option value="Altul">Altul...</option>
                            </select>
                            <span asp-validation-for="RelatedEntity" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label text-white fw-bold"></label>
                            <input asp-for="Title" class="form-control bg-dark text-info border-info" placeholder="Ex: Antrenament aruncări 3pct" autocomplete="off" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label text-white fw-bold"></label>
                                <input asp-for="StartTime" type="datetime-local" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndTime" class="form-label text-white fw-bold"></label>
                                <input asp-for="EndTime" type="datetime-local" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label text-white fw-bold"></label>
                            <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Unde se ține sau alte detalii..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="text-end border-top border-secondary pt-3">
                            <button type="submit" class="btn btn-cyber fw-bold px-5">
                                <i class="fas fa-save me-2"></i>Salvează în Calendar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}