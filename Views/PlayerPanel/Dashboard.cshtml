@model Licenta.Models.ViewModels.PlayerDashboardViewModel

@{
    ViewData["Title"] = "Player Dashboard";

    string ovStatus = ViewBag.OverallStatus as string ?? "NECUNOSCUT";
    string borderClass = ovStatus == "APT DE JOC" ? "border-success" :
                         ovStatus == "INDISPONIBIL (ACCIDENTAT)" ? "border-danger" : "border-warning";

    string textClass = ovStatus == "APT DE JOC" ? "text-success" :
                       ovStatus == "INDISPONIBIL (ACCIDENTAT)" ? "text-danger" : "text-warning";

    string iconClass = ovStatus == "APT DE JOC" ? "fa-check-circle" :
                       ovStatus == "INDISPONIBIL (ACCIDENTAT)" ? "fa-briefcase-medical" : "fa-exclamation-triangle";
}

<div class="container-fluid py-4">

    <div class="card glass-card border-info mb-4 shadow-sm" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(6, 182, 212, 0.15)) !important;">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center">

            <div class="d-flex align-items-center mb-3 mb-md-0">
                <div class="cyber-avatar me-4 shadow-lg border-info" style="width: 90px; height: 90px; font-size: 2.5rem; background: rgba(0,0,0,0.5);">
                    <span>@(Model.StaffInfo.FirstName?.Substring(0, 1))@(Model.StaffInfo.LastName?.Substring(0, 1))</span>
                </div>
                <div>
                    <h1 class="text-info fw-bold mb-1" style="text-shadow: 0 0 15px rgba(6, 182, 212, 0.6);">
                        @Model.StaffInfo.FirstName @Model.StaffInfo.LastName
                    </h1>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="badge badge-cyber fs-6 px-3 py-2">
                            <i class="fas fa-tshirt me-1"></i> #@Model.PlayerInfo.JerseyNumber
                        </span>
                        <span class="badge badge-cyber fs-6 px-3 py-2">
                            <i class="fas fa-bullseye me-1"></i> @Model.PlayerInfo.Position
                        </span>
                        <span class="badge badge-cyber fs-6 px-3 py-2 text-white">
                            <i class="fas fa-arrows-alt-v me-1"></i> @Model.PlayerInfo.Height cm
                        </span>
                        <span class="badge badge-cyber fs-6 px-3 py-2 text-white border-warning ms-1">
                            <i class="fas fa-trophy text-warning me-1"></i> Record: @ViewBag.Wins W - @ViewBag.Losses L
                        </span>
                    </div>
                </div>
            </div>

            <div class="text-md-end pt-3 pt-md-0">
                @if (Model.ActiveContract != null)
                {
                    <div class="d-flex flex-column align-items-md-end gap-2">
                        <span class="badge bg-dark text-success border border-success px-3 py-2 shadow-sm">
                            <i class="fas fa-file-signature me-2"></i>Contract Activ până în @(Model.ActiveContract.EndDate.HasValue? Model.ActiveContract.EndDate.Value.Year.ToString() : "nedeterminat")
                        </span>

                        @if (!string.IsNullOrEmpty(Model.ActiveContract.SignedFilePath))
                        {
                            <a href="@Model.ActiveContract.SignedFilePath" target="_blank" class="btn btn-sm btn-info text-dark fw-bold mt-1 shadow-sm" style="width: fit-content;">
                                <i class="fas fa-file-pdf me-1"></i> Descarcă Copia PDF
                            </a>
                        }
                    </div>
                }
                else
                {
                    <span class="badge bg-dark text-warning border border-warning px-3 py-2 shadow-sm">
                        <i class="fas fa-exclamation-triangle me-2"></i>Fără contract activ
                    </span>
                }
            </div>

        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="card glass-card h-100 stat-card border-info text-center py-3">
                <i class="fas fa-basketball-ball fs-1 text-info opacity-50 mb-2"></i>
                <h2 class="display-5 fw-bold text-white mb-0">@Model.AvgPoints</h2>
                <p class="text-muted text-uppercase small fw-bold mb-0">Medie Puncte (PPG)</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card glass-card h-100 stat-card border-warning text-center py-3">
                <i class="fas fa-hands fs-1 text-warning opacity-50 mb-2"></i>
                <h2 class="display-5 fw-bold text-white mb-0">@Model.AvgRebounds</h2>
                <p class="text-muted text-uppercase small fw-bold mb-0">Recuperări (RPG)</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card glass-card h-100 stat-card border-success text-center py-3">
                <i class="fas fa-people-carry fs-1 text-success opacity-50 mb-2"></i>
                <h2 class="display-5 fw-bold text-white mb-0">@Model.AvgAssists</h2>
                <p class="text-muted text-uppercase small fw-bold mb-0">Pase (APG)</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card glass-card h-100 stat-card border-primary text-center py-3">
                <i class="fas fa-stopwatch fs-1 text-primary opacity-50 mb-2"></i>
                <h2 class="display-5 fw-bold text-white mb-0">@Model.GamesPlayed</h2>
                <p class="text-muted text-uppercase small fw-bold mb-0">Meciuri Jucate</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card glass-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-info fw-bold"><i class="fas fa-chart-line me-2"></i>Ultimele Performanțe</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 text-center">
                            <thead>
                                <tr>
                                    <th class="ps-4 text-start">Data Meciului</th>
                                    <th>Scor (Club - Adversar)</th>
                                    <th>Puncte</th>
                                    <th>Rec</th>
                                    <th>Pase</th>
                                    <th>Evoluție</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentPerformances.Any())
                                {
                                    @foreach (var stat in Model.RecentPerformances)
                                    {
                                        <tr>
                                            <td class="ps-4 text-start text-white">
                                                <i class="far fa-calendar-alt text-muted me-2"></i>
                                                @stat.Game.GameDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td class="text-white text-nowrap">
                                                <span class="fw-bold @(stat.Game.ClubScore > stat.Game.OpponentScore ? "text-success" : "text-white")">@stat.Game.ClubScore</span>
                                                <span class="mx-1 text-muted">-</span>
                                                <span class="fw-bold @(stat.Game.OpponentScore > stat.Game.ClubScore ? "text-danger" : "text-white")">@stat.Game.OpponentScore</span>
                                            </td>

                                            <td class="fw-bold text-info fs-5">@stat.Points</td>
                                            <td class="text-white">@stat.Rebounds</td>
                                            <td class="text-white">@stat.Assists</td>
                                            <td>
                                                <span class="badge bg-dark text-success border border-success">Înregistrat</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Nu există date recente.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @if (Model.NextEvent != null)
            {
                <div class="card glass-card border-warning mb-4 shadow-lg" style="background: linear-gradient(135deg, rgba(15,23,42,0.9), rgba(245,158,11,0.1));">
                    <div class="card-body p-4 text-center">
                        <h6 class="text-warning fw-bold mb-1 text-uppercase letter-spacing">
                            <i class="fas fa-stopwatch me-2"></i>Următorul Eveniment
                        </h6>
                        <h4 class="text-white fw-bold mb-1">@Model.NextEvent.Title</h4>
                        <p class="text-muted small mb-3">
                            <span class="badge bg-secondary me-2">@Model.NextEvent.RelatedEntity</span>
                            @Model.NextEvent.StartTime.ToString("dd MMM yyyy, HH:mm")
                        </p>

                        <div id="event-countdown" class="d-flex justify-content-center gap-2" data-time="@Model.NextEvent.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                            <div class="bg-dark border border-warning rounded p-2 text-center" style="min-width: 70px; box-shadow: 0 0 10px rgba(245,158,11,0.2);">
                                <h3 class="text-white mb-0 fw-bold" id="cd-days">00</h3>
                                <small class="text-muted text-uppercase" style="font-size:0.6rem;">Zile</small>
                            </div>
                            <div class="bg-dark border border-warning rounded p-2 text-center" style="min-width: 70px; box-shadow: 0 0 10px rgba(245,158,11,0.2);">
                                <h3 class="text-white mb-0 fw-bold" id="cd-hours">00</h3>
                                <small class="text-muted text-uppercase" style="font-size:0.6rem;">Ore</small>
                            </div>
                            <div class="bg-dark border border-warning rounded p-2 text-center" style="min-width: 70px; box-shadow: 0 0 10px rgba(245,158,11,0.2);">
                                <h3 class="text-white mb-0 fw-bold" id="cd-mins">00</h3>
                                <small class="text-muted text-uppercase" style="font-size:0.6rem;">Min</small>
                            </div>
                            <div class="bg-dark border border-warning rounded p-2 text-center" style="min-width: 70px; box-shadow: 0 0 10px rgba(245,158,11,0.2);">
                                <h3 class="text-white mb-0 fw-bold" id="cd-secs">00</h3>
                                <small class="text-muted text-uppercase" style="font-size:0.6rem;">Sec</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card glass-card mb-4 @borderClass">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold @textClass">
                        <i class="fas fa-heartbeat me-2"></i>Status Operațional
                    </h5>
                </div>
                <div class="card-body">
                    @if (ovStatus == "APT DE JOC")
                    {
                        <div class="text-center py-2">
                            <i class="fas fa-check-circle fs-1 text-success mb-2 shadow-sm"></i>
                            <h6 class="text-white">Apt pentru joc</h6>
                            <small class="text-muted">Documentație la zi și nicio accidentare activă.</small>
                        </div>
                    }
                    else if (ovStatus == "INDISPONIBIL (ACCIDENTAT)")
                    {
                        foreach (var injury in Model.ActiveInjuries)
                        {
                            <div class="d-flex align-items-center mb-2 p-2 bg-dark bg-opacity-50 rounded border border-danger border-opacity-25">
                                <i class="fas fa-briefcase-medical fs-4 text-danger me-3"></i>
                                <div>
                                    <h6 class="text-white fw-bold mb-0">@injury.Description</h6>
                                    <small class="text-muted">Din: @injury.StartDate.ToString("dd MMM yyyy")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-2">
                            <i class="fas @iconClass fs-1 @textClass mb-2 shadow-sm pulse-danger"></i>
                            <h6 class="text-white text-uppercase letter-spacing">Ineligibil</h6>
                            <small class="text-muted fw-bold">@ovStatus</small>
                        </div>
                    }
                </div>
            </div>

            <div class="card glass-card border-secondary">
                <div class="card-header">
                    <h5 class="mb-0 text-white fw-bold"><i class="fas fa-calendar-day me-2 text-primary"></i>Meciuri Programate</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush bg-transparent">
                        @if (Model.UpcomingGames.Any())
                        {
                            foreach (var game in Model.UpcomingGames)
                            {
                                <li class="list-group-item bg-transparent border-bottom border-secondary d-flex justify-content-between align-items-center p-3">
                                    <div>
                                        <h6 class="text-white mb-1">@(string.IsNullOrEmpty(game.OpponentName) ? "Meci" : "vs " + game.OpponentName)</h6>
                                        <small class="text-primary d-block"><i class="fas fa-map-marker-alt me-1"></i> @(game.Location ?? "Locație nesetată")</small>
                                        <small class="text-muted"><i class="far fa-clock me-1"></i> @game.GameDate.ToString("dd MMM HH:mm")</small>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item bg-transparent text-muted p-3 text-center">Niciun meci programat.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var cdElement = document.getElementById('event-countdown');
            if(!cdElement) return;
            var targetDate = new Date(cdElement.getAttribute('data-time')).getTime();
            var timer = setInterval(function() {
                var now = new Date().getTime();
                var distance = targetDate - now;

                if (distance < 0) {
                    clearInterval(timer);
                    cdElement.innerHTML = "<h5 class='text-success mt-3 fw-bold pulse-danger'><i class='fas fa-play-circle me-2'></i>Evenimentul a început!</h5>";
                    return;
                }

                var days = Math.floor(distance / (1000 * 60 * 60 * 24));
                var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById('cd-days').innerText = days < 10 ? '0' + days : days;
                document.getElementById('cd-hours').innerText = hours < 10 ? '0' + hours : hours;
                document.getElementById('cd-mins').innerText = minutes < 10 ? '0' + minutes : minutes;
                document.getElementById('cd-secs').innerText = seconds < 10 ? '0' + seconds : seconds;
            }, 1000);
        });
    </script>
}