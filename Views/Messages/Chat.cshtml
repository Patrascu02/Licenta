@model Licenta.Models.ViewModels.ChatViewModel
@{
    ViewData["Title"] = "Chat";
}

<div class="container-fluid py-4 h-100 d-flex flex-column" style="max-height: 85vh;">
    <div class="card glass-card mb-3 border-info">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-info btn-sm me-3 shadow-sm rounded-circle" style="width:35px; height:35px; padding-top:6px;">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="cyber-avatar me-3" style="width: 45px; height: 45px;">
                    <span>@(Model.OtherStaff.FirstName?.Substring(0, 1))</span>
                </div>
                <div>
                    <h5 class="text-white fw-bold mb-0">@Model.OtherStaff.FirstName @Model.OtherStaff.LastName</h5>
                    <small class="text-success"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i>Conexiune Securizată</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card glass-card flex-grow-1 mb-3 overflow-hidden position-relative">
        <div class="card-body p-4 overflow-auto" id="chatContainer" style="height: 50vh;">

            @if (!Model.Messages.Any())
            {
                <div class="text-center mt-5">
                    <i class="fas fa-comment-dots fs-1 text-muted mb-3 opacity-50"></i>
                    <h6 class="text-muted">Conversația este goală. Transmite primul mesaj!</h6>
                </div>
            }

            @foreach (var msg in Model.Messages)
            {
                bool isMine = msg.FromStaffId == Model.CurrentStaff.StaffId;

                <div class="d-flex mb-4 @(isMine ? "justify-content-end" : "justify-content-start")">
                    <div class="p-3 shadow-sm"
                         style="max-width: 75%; border-radius: 12px;
                                    @(isMine ? "background: rgba(6, 182, 212, 0.2); border: 1px solid var(--neon-primary); color: #fff; border-bottom-right-radius: 2px;"
                                                                  : "background: rgba(30, 41, 59, 0.9); border: 1px solid rgba(148, 163, 184, 0.3); color: var(--cyber-text-primary); border-bottom-left-radius: 2px;")">
                    <p class="mb-1" style="word-wrap: break-word;">@msg.Text</p>
                    <div class="text-end mt-1">
                        <small class="opacity-75" style="font-size: 0.7rem;">
                            @msg.SentAt.ToString("HH:mm")
                            @if (isMine)
                                {
                                    <i class="fas fa-check-double ms-1 @(msg.IsRead ? "text-info" : "text-muted")"></i>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card glass-card">
        <div class="card-body p-2">
            <form asp-action="SendMessage" method="post" class="d-flex align-items-center">
                <input type="hidden" name="toStaffId" value="@Model.OtherStaff.StaffId" />
                <input type="text" name="text" class="form-control bg-transparent border-0 text-white shadow-none px-3 py-2"
                       placeholder="Inițiază transmisia..." autocomplete="off" required autofocus />
                <button type="submit" class="btn btn-cyber ms-2 rounded-circle" style="width: 45px; height: 45px;">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    window.onload = function() {
        var chatContainer = document.getElementById("chatContainer");
        chatContainer.scrollTop = chatContainer.scrollHeight;
    };
</script>