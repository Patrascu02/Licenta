@model Licenta.Models.ViewModels.GroupChatViewModel
@{
    ViewData["Title"] = "Grup: " + Model.Group.Name;
}

<div class="container-fluid py-4 h-100 d-flex flex-column" style="max-height: 85vh;">
    <div class="card glass-card mb-3 border-primary">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-primary btn-sm me-3 rounded-circle"><i class="fas fa-arrow-left"></i></a>
                <div class="cyber-avatar me-3 bg-primary text-white" style="width: 45px; height: 45px;">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h5 class="text-white fw-bold mb-0">@Model.Group.Name</h5>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#membersModal" class="text-info text-decoration-none small cyber-link-hover">
                        <i class="fas fa-eye me-1"></i>Vezi cei @Model.Group.Members.Count membri
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card glass-card flex-grow-1 mb-3 overflow-hidden">
        <div class="card-body p-4 overflow-auto" id="chatContainer" style="height: 50vh;">
            @foreach (var msg in Model.Messages)
            {
                bool isMine = msg.FromStaffId == Model.CurrentStaff.StaffId;
                <div class="d-flex mb-4 @(isMine ? "justify-content-end" : "justify-content-start")">
                    <div class="p-3 shadow-sm" style="max-width: 75%; border-radius: 12px; @(isMine ? "background: rgba(6, 182, 212, 0.2); border: 1px solid var(--neon-primary);" : "background: rgba(30, 41, 59, 0.9); border: 1px solid rgba(148, 163, 184, 0.3);")">
                        @if (!isMine)
                        {
                            <small class="d-block text-info fw-bold mb-1 border-bottom border-secondary pb-1">@msg.FromStaff.FirstName @msg.FromStaff.LastName</small>
                        }
                        <p class="mb-1 text-white" style="word-wrap: break-word;">@msg.Text</p>
                        <div class="text-end mt-1"><small class="text-muted" style="font-size: 0.7rem;">@msg.SentAt.ToString("dd MMM HH:mm")</small></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card glass-card">
        <div class="card-body p-2">
            <form asp-action="SendGroupMessage" method="post" class="d-flex align-items-center">
                <input type="hidden" name="groupId" value="@Model.Group.GroupId" />
                <input type="text" name="text" class="form-control bg-transparent border-0 text-white shadow-none px-3" placeholder="Scrie în grup..." required autocomplete="off" autofocus />
                <button type="submit" class="btn btn-cyber rounded-circle"><i class="fas fa-paper-plane"></i></button>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="membersModal" tabindex="-1" aria-labelledby="membersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="background: #0f172a; border: 1px solid var(--neon-primary); box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-info fw-bold" id="membersModalLabel"><i class="fas fa-users me-2"></i>Membrii Grupului</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="list-group list-group-flush bg-transparent">
                    @foreach (var member in Model.Group.Members)
                    {
                        <li class="list-group-item bg-transparent text-white border-secondary d-flex align-items-center p-3">
                            <div class="cyber-avatar me-3" style="width: 40px; height: 40px; font-size: 1rem;">
                                <span>@(member.Staff.FirstName?.Substring(0, 1))@(member.Staff.LastName?.Substring(0, 1))</span>
                            </div>
                            <div>
                                <span class="d-block fw-bold">@member.Staff.FirstName @member.Staff.LastName</span>
                                @if (member.StaffId == Model.CurrentStaff.StaffId)
                                {
                                    <span class="badge bg-success" style="font-size:0.6rem;">Tu</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-outline-info" data-bs-dismiss="modal">Închide</button>
            </div>
        </div>
    </div>
</div>
<script>
    window.onload = function() { var c = document.getElementById("chatContainer"); c.scrollTop = c.scrollHeight; };
</script>