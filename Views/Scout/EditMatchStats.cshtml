@model Licenta.Models.ViewModels.EditGameStatsViewModel
@{
    ViewData["Title"] = "Raport Meci";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-info fw-bold mb-0"><i class="fas fa-clipboard-list me-2"></i>Raport Meci</h2>
            <p class="text-muted mb-0">@Model.GameInfo</p>
        </div>
        <a asp-action="MatchReports" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi</a>
    </div>

    <div class="card glass-card border-info shadow-lg">
        <div class="card-body p-4">
            <form asp-action="EditMatchStats" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>
                <input type="hidden" asp-for="GameId" />

                <div class="row g-4 mb-5 p-4 rounded" style="background-color: rgba(0,0,0,0.2); border: 1px solid #334155;">
                    <div class="col-md-6 text-center">
                        <label class="form-label text-success fw-bold fs-5 mb-3">
                            <i class="fas fa-shield-alt me-2"></i>Puncte @(ViewBag.OurTeamName ?? "Echipa Noastră")
                        </label>
                        <input asp-for="HomeScore" class="form-control form-control-lg text-center fw-bold fs-3 border-success text-white shadow-none" style="background-color: #0f172a; max-width: 150px; margin: 0 auto;" type="number" min="0" required />
                        <span asp-validation-for="HomeScore" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 text-center border-start border-secondary">
                        <label class="form-label text-warning fw-bold fs-5 mb-3">
                            <i class="fas fa-khanda me-2"></i>Puncte @(ViewBag.OpponentName ?? "Adversar")
                        </label>
                        <input asp-for="AwayScore" class="form-control form-control-lg text-center fw-bold fs-3 border-warning text-white shadow-none" style="background-color: #0f172a; max-width: 150px; margin: 0 auto;" type="number" min="0" required />
                        <span asp-validation-for="AwayScore" class="text-danger small"></span>
                    </div>
                </div>

                <h5 class="text-white fw-bold mb-3"><i class="fas fa-users me-2 text-primary"></i>Statistici Individuale</h5>
                <div class="alert alert-warning bg-warning bg-opacity-10 border-warning text-warning small p-2 mb-3">
                    <i class="fas fa-exclamation-triangle me-2"></i>Atenție: Suma punctelor jucătorilor noștri trebuie să fie egală cu <strong>punctele marcate de @(ViewBag.OurTeamName)</strong>!
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-dark table-hover align-middle text-center border-secondary">
                        <thead class="bg-secondary bg-opacity-25">
                            <tr>
                                <th class="text-start ps-3">Jucător</th>
                                <th>Poziție</th>
                                <th>MIN</th>
                                <th>PCT</th>
                                <th>REC</th>
                                <th>PAS</th>
                                <th>INT</th>
                                <th>CAP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PlayerStats.Count; i++)
                            {
                                <tr>
                                    <td class="text-start ps-3">
                                        <input type="hidden" asp-for="PlayerStats[i].PlayerId" />
                                        <input type="hidden" asp-for="PlayerStats[i].PlayerGameStatsId" />
                                        <span class="text-white fw-bold d-block">@Model.PlayerStats[i].PlayerName</span>
                                        <span class="badge bg-secondary">#@Model.PlayerStats[i].JerseyNumber</span>
                                    </td>
                                    <td>@Model.PlayerStats[i].Position</td>
                                    <td><input asp-for="PlayerStats[i].MinutesPlayed" class="form-control form-control-sm text-center bg-dark text-white border-secondary" type="number" min="0" max="60" /></td>
                                    <td><input asp-for="PlayerStats[i].Points" class="form-control form-control-sm text-center bg-dark text-white border-primary" type="number" min="0" /></td>
                                    <td><input asp-for="PlayerStats[i].Rebounds" class="form-control form-control-sm text-center bg-dark text-white border-secondary" type="number" min="0" /></td>
                                    <td><input asp-for="PlayerStats[i].Assists" class="form-control form-control-sm text-center bg-dark text-white border-secondary" type="number" min="0" /></td>
                                    <td><input asp-for="PlayerStats[i].Steals" class="form-control form-control-sm text-center bg-dark text-white border-secondary" type="number" min="0" /></td>
                                    <td><input asp-for="PlayerStats[i].Blocks" class="form-control form-control-sm text-center bg-dark text-white border-secondary" type="number" min="0" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="submit" class="btn btn-cyber w-100 fw-bold fs-5 py-3">
                    <i class="fas fa-check-double me-2"></i>Salvează Raportul
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: var(--neon-primary) !important;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5) !important;
    }

    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        opacity: 1;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}