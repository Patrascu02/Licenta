@model Licenta.Models.ViewModels.EditGameStatsViewModel
@{
    ViewData["Title"] = "Statistici Meci";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-success fw-bold mb-1"><i class="fas fa-clipboard-check me-2"></i>Fișă Meci</h2>
            <h6 class="text-info ms-1">@Model.GameInfo</h6>
        </div>
        <a asp-action="MatchReports" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>Înapoi</a>
    </div>

    <div class="card glass-card border-success">
        <div class="card-body p-0">
            <form asp-action="EditMatchStats" method="post">
                <input type="hidden" asp-for="GameId" />

                <div asp-validation-summary="All" class="alert alert-danger bg-danger bg-opacity-25 text-white border-danger m-3 fw-bold shadow-sm" style="display: @(ViewData.ModelState.IsValid ? "none" : "block");">
                    <i class="fas fa-exclamation-triangle me-2"></i> Datele nu au putut fi salvate:
                </div>

                <div class="row g-3 mx-2 mt-2 mb-4 p-3 bg-dark bg-opacity-50 border border-secondary rounded">
                    <div class="col-md-6 text-center">
                        <label class="text-white fw-bold d-block mb-2">Puncte Acasă</label>
                        <input asp-for="HomeScore" type="number" min="0" class="form-control form-control-lg bg-dark text-success border-success text-center mx-auto fw-bold" style="max-width: 150px; font-size: 1.5rem;" required />
                    </div>
                    <div class="col-md-6 text-center">
                        <label class="text-white fw-bold d-block mb-2">Puncte Deplasare</label>
                        <input asp-for="AwayScore" type="number" min="0" class="form-control form-control-lg bg-dark text-danger border-danger text-center mx-auto fw-bold" style="max-width: 150px; font-size: 1.5rem;" required />
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 65vh; overflow-y: auto;">
                    <table class="table table-hover table-dark align-middle mb-0 bg-transparent text-center sticky-header-table">
                        <thead class="border-secondary text-info sticky-top" style="background-color: #0f172a; z-index: 10;">
                            <tr>
                                <th class="text-start ps-4">Jucător</th>
                                <th>MIN</th>
                                <th>PCT</th>
                                <th>REC</th>
                                <th>PAS</th>
                                <th>INT</th>
                                <th>CAP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.PlayerStats.Count; i++)
                            {
                                <tr>
                                    <td class="text-start ps-4">
                                        <input type="hidden" asp-for="PlayerStats[i].PlayerId" />
                                        <input type="hidden" asp-for="PlayerStats[i].PlayerGameStatsId" />

                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-secondary me-2" style="min-width:35px;">#@Model.PlayerStats[i].JerseyNumber</span>
                                            <span class="fw-bold text-white d-inline-block text-truncate" style="max-width: 150px;">@Model.PlayerStats[i].PlayerName</span>
                                            <span class="badge border border-secondary text-muted ms-2" style="font-size:0.6rem;">@Model.PlayerStats[i].Position</span>
                                        </div>
                                    </td>
                                    <td style="width: 100px;">
                                        <input asp-for="PlayerStats[i].MinutesPlayed" class="form-control form-control-sm bg-dark text-warning border-secondary text-center fw-bold" placeholder="0" />
                                    </td>
                                    <td style="width: 90px;">
                                        <input asp-for="PlayerStats[i].Points" class="form-control form-control-sm bg-dark text-success border-secondary text-center fw-bold" placeholder="0" />
                                    </td>
                                    <td style="width: 90px;">
                                        <input asp-for="PlayerStats[i].Rebounds" class="form-control form-control-sm bg-dark text-white border-secondary text-center" placeholder="0" />
                                    </td>
                                    <td style="width: 90px;">
                                        <input asp-for="PlayerStats[i].Assists" class="form-control form-control-sm bg-dark text-white border-secondary text-center" placeholder="0" />
                                    </td>
                                    <td style="width: 90px;">
                                        <input asp-for="PlayerStats[i].Steals" class="form-control form-control-sm bg-dark text-white border-secondary text-center" placeholder="0" />
                                    </td>
                                    <td style="width: 90px;">
                                        <input asp-for="PlayerStats[i].Blocks" class="form-control form-control-sm bg-dark text-white border-secondary text-center" placeholder="0" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top border-success bg-dark bg-opacity-50 text-end">
                    <p class="text-muted small mb-2 d-inline-block me-3 text-start"><i class="fas fa-info-circle me-1"></i>Jucătorii lăsați cu "0" la minute nu vor fi salvați în baza de date (s-au aflat pe bancă toată partida).</p>
                    <button type="submit" class="btn btn-cyber px-5 fw-bold fs-5">
                        <i class="fas fa-save me-2"></i>Salvează Raportul Tactic
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .sticky-header-table th {
        border-bottom: 2px solid var(--neon-primary) !important;
    }

    .table input:focus {
        border-color: var(--neon-primary) !important;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
    }
    input[type="number"]::-webkit-outer-spin-button, input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>