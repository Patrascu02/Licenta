@using Licenta.Models.Sports
@model PlayerGameStats

@{
    ViewData["Title"] = "Adaugă Medii Lunare";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-chart-line me-2"></i>Raport Scouting: @ViewBag.PlayerName</h4>
        </div>
        <div class="card-body bg-light">
            <form asp-controller="Scout" asp-action="AddMonthlyStats" method="post" id="scoutingForm">

                <div asp-validation-summary="All" class="text-danger mb-3 p-3 bg-white border border-danger rounded" style="display:none"></div>

                <input type="hidden" asp-for="PlayerId" />
                <input type="hidden" asp-for="IsScoutingReport" value="true" />

                <input type="hidden" asp-for="GameId" value="" />

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Month" class="form-label fw-bold">Luna</label>
                        <select asp-for="Month" class="form-select border-primary shadow-sm">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label fw-bold">Anul</label>
                        <input asp-for="Year" type="number" class="form-control border-primary shadow-sm" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                </div>

                <h5 class="text-secondary border-bottom pb-2 mb-3">
                    <i class="fas fa-basketball-ball me-2"></i>Statistici Medii (per meci în lună)
                </h5>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Points" class="form-label">Puncte</label>
                        <input asp-for="Points" type="number" step="0.1" min="0" class="form-control shadow-sm" placeholder="0.0" />
                        <span asp-validation-for="Points" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Rebounds" class="form-label">Recuperări</label>
                        <input asp-for="Rebounds" type="number" step="0.1" min="0" class="form-control shadow-sm" placeholder="0.0" />
                        <span asp-validation-for="Rebounds" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Assists" class="form-label">Pase Decisive</label>
                        <input asp-for="Assists" type="number" step="0.1" min="0" class="form-control shadow-sm" placeholder="0.0" />
                        <span asp-validation-for="Assists" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Steals" class="form-label">Intercepții</label>
                        <input asp-for="Steals" type="number" step="0.1" min="0" class="form-control shadow-sm" placeholder="0.0" />
                        <span asp-validation-for="Steals" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Blocks" class="form-label">Capace</label>
                        <input asp-for="Blocks" type="number" step="0.1" min="0" class="form-control shadow-sm" placeholder="0.0" />
                        <span asp-validation-for="Blocks" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MinutesPlayed" class="form-label">Minute (Medie/Meci)</label>
                        <input asp-for="MinutesPlayed" type="number" step="0.1" min="0" class="form-control shadow-sm" placeholder="0.0" />
                        <span asp-validation-for="MinutesPlayed" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-5 d-flex justify-content-between border-top pt-3">
                    <a asp-controller="Players" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Înapoi la listă
                    </a>
                    <button type="submit" class="btn btn-success px-5 fw-bold shadow">
                        <i class="fas fa-save me-1"></i> Salvează Raportul
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Script de Debugging: Afișează o alertă dacă formularul este invalid când apeși Submit
        $(document).ready(function () {
            $('form').on('submit', function (e) {
                if (!$(this).valid()) {
                    alert("Formularul NU s-a trimis! Verifică câmpurile roșii.");
                }
            });

            // Afișează div-ul de erori doar dacă are text în el
            if ($('.validation-summary-errors').length > 0) {
                $('.validation-summary-errors').show();
            }
        });
    </script>
}