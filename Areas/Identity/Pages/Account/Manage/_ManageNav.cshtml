@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<ul class="nav nav-pills flex-column gap-2">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext) d-flex align-items-center" id="profile" asp-page="./Index">
            <div class="icon-wrapper"><i class="fas fa-user-circle"></i></div>
            <span>Profil</span>
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext) d-flex align-items-center" id="change-password" asp-page="./ChangePassword">
            <div class="icon-wrapper"><i class="fas fa-key"></i></div>
            <span>Parolă</span>
        </a>
    </li>

    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext) d-flex align-items-center" asp-page="./ExternalLogins">
                <div class="icon-wrapper"><i class="fas fa-share-alt"></i></div>
                <span>Login Extern</span>
            </a>
        </li>
    }

    @*<li class="nav-item">
        <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) d-flex align-items-center" id="two-factor" asp-page="./TwoFactorAuthentication">
            <div class="icon-wrapper"><i class="fas fa-shield-alt"></i></div>
            <span>Autentificare 2FA</span>
        </a>
    </li>*@

    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext) d-flex align-items-center" id="personal-data" asp-page="./PersonalData">
            <div class="icon-wrapper"><i class="fas fa-database"></i></div>
            <span>Date Personale</span>
        </a>
    </li>
</ul>

<style>

    .nav-pills .nav-link {
        color: #4b5563 !important;
        background-color: transparent !important;
        font-weight: 600;
        border-radius: 12px;
        padding: 12px 16px;
        transition: all 0.2s ease-in-out;
        border: 1px solid transparent;
    }

        .nav-pills .nav-link:hover {
            background-color: #f3f4f6 !important; 
            color: var(--primary-color, #0d6efd) !important;
            transform: translateX(5px);
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
            color: white !important; 
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            border: none;
        }

    .icon-wrapper {
        width: 24px;
        text-align: center;
        margin-right: 12px;
        font-size: 1.1rem;
    }

    .nav-link.active .icon-wrapper {
        color: white !important;
    }
</style>