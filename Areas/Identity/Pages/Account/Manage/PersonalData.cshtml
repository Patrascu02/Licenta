@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Date Personale & Contract";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm glass-card h-100">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fas fa-file-signature me-2 text-primary"></i>Informații Contractuale
            </h5>
            <p class="text-muted small mt-1">Aici poți vizualiza detaliile contractului tău activ și poți descărca o copie în format PDF.</p>
        </div>

        <div class="card-body p-4">
            @if (Model.ActiveContract != null)
            {
                <div class="bg-light bg-opacity-50 p-4 rounded-3 border border-light mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="fw-bold text-success mb-3"><i class="fas fa-check-circle me-2"></i>Contract Activ</h5>

                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <span class="text-muted"><i class="far fa-calendar-check me-2"></i>Dată Semnare:</span>
                                    <span class="fw-bold text-dark">@Model.ActiveContract.StartDate.ToString("dd MMMM yyyy")</span>
                                </li>
                                <li>
                                    <span class="text-muted"><i class="far fa-calendar-times me-2"></i>Dată Expirare:</span>
                                    <span class="fw-bold text-dark">@(Model.ActiveContract.EndDate.HasValue? Model.ActiveContract.EndDate.Value.ToString("dd MMMM yyyy") : "Perioadă nedeterminată")</span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-4 text-md-end mt-4 mt-md-0">
                            @if (!string.IsNullOrEmpty(Model.ActiveContract.SignedFilePath))
                            {
                                <a href="@Model.ActiveContract.SignedFilePath" target="_blank" class="btn btn-primary shadow-lg rounded-pill px-4 py-2 fw-bold">
                                    <i class="fas fa-file-download me-2"></i>Descarcă PDF
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark p-2"><i class="fas fa-exclamation-circle me-1"></i>Document PDF Nedisponibil</span>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning border-warning border-opacity-50 bg-warning bg-opacity-10 d-flex align-items-center">
                    <i class="fas fa-exclamation-triangle fa-2x text-warning me-3"></i>
                    <div>
                        <h6 class="alert-heading fw-bold mb-1">Nu ai niciun contract activ.</h6>
                        <p class="mb-0 small text-muted">Dacă crezi că aceasta este o eroare, te rugăm să contactezi General Manager-ul clubului.</p>
                    </div>
                </div>
            }

            <hr class="my-5 opacity-25" />

            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-database me-2 text-secondary"></i>Gestiune Date GDPR</h5>
            <p class="text-muted small mb-4">Contul tău conține date cu caracter personal pe care ni le-ai furnizat. Poți descărca aceste date sau poți solicita ștergerea completă a contului (acțiune ireversibilă).</p>

            <div class="d-flex gap-3">
                <form id="download-data" asp-page="DownloadPersonalData" method="post">
                    <button class="btn btn-outline-secondary fw-bold rounded-pill px-4" type="submit">
                        <i class="fas fa-download me-1"></i> Export Date
                    </button>
                </form>
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger fw-bold rounded-pill px-4">
                    <i class="fas fa-trash-alt me-1"></i> Șterge Contul
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border-radius: 20px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}