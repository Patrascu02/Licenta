@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Schimbare Parolă";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm glass-card">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fas fa-shield-alt me-2 text-primary"></i>Securitate Cont
            </h5>
            <p class="text-muted small mt-1">Actualizează parola pentru a-ți menține contul în siguranță.</p>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-8 col-lg-6">
                    <form id="change-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-4 position-relative">
                            <input asp-for="Input.OldPassword" class="form-control pe-5 password-field" autocomplete="current-password" aria-required="true" placeholder="Parola curentă" />
                            <label asp-for="Input.OldPassword" class="form-label">Parola Curentă (sau Temporară)</label>

                            <span class="position-absolute top-50 end-0 translate-middle-y pe-3 toggle-password" style="cursor: pointer; z-index: 10;">
                                <i class="fas fa-eye text-muted"></i>
                            </span>

                            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.NewPassword" class="form-control pe-5 password-field" autocomplete="new-password" aria-required="true" placeholder="Parola nouă" />
                            <label asp-for="Input.NewPassword" class="form-label">Parola Nouă</label>

                            <span class="position-absolute top-50 end-0 translate-middle-y pe-3 toggle-password" style="cursor: pointer; z-index: 10;">
                                <i class="fas fa-eye text-muted"></i>
                            </span>

                            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4 position-relative">
                            <input asp-for="Input.ConfirmPassword" class="form-control pe-5 password-field" autocomplete="new-password" aria-required="true" placeholder="Confirmă parola" />
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmă Parola Nouă</label>

                            <span class="position-absolute top-50 end-0 translate-middle-y pe-3 toggle-password" style="cursor: pointer; z-index: 10;">
                                <i class="fas fa-eye text-muted"></i>
                            </span>

                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary shadow-lg rounded-pill px-5 py-2 fw-bold w-100">
                            <i class="fas fa-save me-2"></i>Actualizează Parola
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border-radius: 20px;
    }

    .toggle-password:hover i {
        color: var(--bs-primary) !important;
        transform: scale(1.1);
        transition: 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.toggle-password').click(function () {
                let icon = $(this).find('i');
                let input = $(this).siblings('input.password-field');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye text-muted').addClass('fa-eye-slash text-primary');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash text-primary').addClass('fa-eye text-muted');
                }
            });
        });
    </script>
}